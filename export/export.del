        "⢛⢜⢝⢞⢟⢠⢡⢢⢣⢤⢥⢦⢧⢨⢩⢪⢫⢬⢭⢮⢯⢰⢱⢲⢳⢴⢵⢶⢷⢸⢹⢺⢻⢼⢽⢾⢿⣀⣁⣂⣃⣄⣅⣆⣇⣈⣉⣊⣋⣌⣍⣎⣏⣐⣑⣒⣓⣔⣕⣖⣗⣘⣙⣚⣛⣜⣝⣞⣟⣠⣡⣢⣣⣤⣥⣦⣧⣨⣩⣪⣫⣬⣭⣮⣯⣰⣱⣲⣳⣴⣵⣶⣷⣸⣹⣺⣻⣼⣽⣾⣿⤀⤁⤂⤃⤄⤅⤆⤇⤈⤉⤊⤋⤌⤍⤎⤏⤐⤑⤒⤓⤔⤕⤖⤗⤘⤙⤚" +
        "⤛⤜⤝⤞⤟⤠⤡⤢⤣⤤⤥⤦⤧⤨⤩⤪⤫⤬⤭⤮⤯⤰⤱⤲⤳⤴⤵⤶⤷⤸⤹⤺⤻⤼⤽⤾⤿⥀⥁⥂⥃⥄⥅⥆⥇⥈⥉⥊⥋⥌⥍⥎⥏⥐⥑⥒⥓⥔⥕⥖⥗⥘⥙⥚⥛⥜⥝⥞⥟⥠⥡⥢⥣⥤⥥⥦⥧⥨⥩⥪⥫⥬⥭⥮⥯⥰⥱⥲⥳⥴⥵⥶⥷⥸⥹⥺⥻⥼⥽⥾⥿⦀⦁⦂⦃⦄⦅⦆⦇⦈⦉⦊⦋⦌⦍⦎⦏⦐⦑⦒⦓⦔⦕⦖⦗⦘⦙⦚" +
        "⦛⦜⦝⦞⦟⦠⦡⦢⦣⦤⦥⦦⦧⦨⦩⦪⦫⦬⦭⦮⦯⦰⦱⦲⦳⦴⦵⦶⦷⦸⦹⦺⦻⦼⦽⦾⦿⧀⧁⧂⧃⧄⧅⧆⧇⧈⧉⧊⧋⧌⧍⧎⧏⧐⧑⧒⧓⧔⧕⧖⧗⧘⧙⧚⧛⧜⧝⧞⧟⧠⧡⧢⧣⧤⧥⧦⧧⧨⧩⧪⧫⧬⧭⧮⧯⧰⧱⧲⧳⧴⧵⧶⧷⧸⧹⧺⧻⧼⧽⧾⧿⨀⨁⨂⨃⨄⨅⨆⨇⨈⨉⨊⨋⨌⨍⨎⨏⨐⨑⨒⨓⨔⨕⨖⨗⨘⨙⨚" +
        "⨛⨜⨝⨞⨟⨠⨡⨢⨣⨤⨥⨦⨧⨨⨩⨪⨫⨬⨭⨮⨯⨰⨱⨲⨳⨴⨵⨶⨷⨸⨹⨺⨻⨼⨽⨾⨿⩀⩁⩂⩃⩄⩅⩆⩇⩈⩉⩊⩋⩌⩍⩎⩏⩐⩑⩒⩓⩔⩕⩖⩗⩘⩙⩚⩛⩜⩝⩞⩟⩠⩡⩢⩣⩤⩥⩦⩧⩨⩩⩪⩫⩬⩭⩮⩯⩰⩱⩲⩳⩴⩵⩶⩷⩸⩹⩺⩻⩼⩽⩾⩿⪀⪁⪂⪃⪄⪅⪆⪇⪈⪉⪊⪋⪌⪍⪎⪏⪐⪑⪒⪓⪔⪕⪖⪗⪘⪙⪚" +
        "⪛⪜⪝⪞⪟⪠⪡⪢⪣⪤⪥⪦⪧⪨⪩⪪⪫⪬⪭⪮⪯⪰⪱⪲⪳⪴⪵⪶⪷⪸⪹⪺⪻⪼⪽⪾⪿⫀⫁⫂⫃⫄⫅⫆⫇⫈⫉⫊⫋⫌⫍⫎⫏⫐⫑⫒⫓⫔⫕⫖⫗⫘⫙⫚⫛⫝⫞⫟⫠⫡⫢⫣⫤⫥⫦⫧⫨⫩⫪⫫⫬⫭⫮⫯⫰⫱⫲⫳⫴⫵⫶⫷⫸⫹⫺⫻⫼⫽⫾⫿⬀⬁⬂⬃⬄⬅⬆⬇⬈⬉⬊⬋⬌⬍⬎⬏⬐⬑⬒⬓⬔⬕⬖⬗⬘⬙⬚⬛" +
        "⬜⬝⬞⬟⬠⬡⬢⬣⬤⬥⬦⬧⬨⬩⬪⬫⬬⬭⬮⬯⬰⬱⬲⬳⬴⬵⬶⬷⬸⬹⬺⬻⬼⬽⬾⬿⭀⭁⭂⭃⭄⭅⭆⭇⭈⭉⭊⭋⭌⭍⭎⭏⭐⭑⭒⭓⭔⭕⭖⭗⭘⭙⭚⭛⭜⭝⭞⭟⭠⭡⭢⭣⭤⭥⭦⭧⭨⭩⭪⭫⭬⭭⭮⭯⭰⭱⭲⭳⭶⭷⭸⭹⭺⭻⭼⭽⭾⭿⮀⮁⮂⮃⮄⮅⮆⮇⮈⮉⮊⮋⮌⮍⮎⮏⮐⮑⮒⮓⮔⮕⮗⮘⮙⮚⮛⮜⮝⮞" +
        "⮟⮠⮡⮢⮣⮤⮥⮦⮧⮨⮩⮪⮫⮬⮭⮮⮯⮰⮱⮲⮳⮴⮵⮶⮷⮸⮹⮺⮻⮼⮽⮾⮿⯀⯁⯂⯃⯄⯅⯆⯇⯈⯉⯊⯋⯌⯍⯎⯏⯐⯑⯒⯓⯔⯕⯖⯗⯘⯙⯚⯛⯜⯝⯞⯟⯠⯡⯢⯣⯤⯥⯦⯧⯨⯩⯪⯫⯬⯭⯮⯯⯰⯱⯲⯳⯴⯵⯶⯷⯸⯹⯺⯻⯼⯽⯾⯿⳥⳦⳧⳨⳩⳪⳹⳺⳻⳼⳾⳿⵰⸀⸁⸂⸃⸄⸅⸆⸇⸈⸉⸊⸋⸌⸍⸎⸏⸐⸑" +
        "⸒⸓⸔⸕⸖⸗⸘⸙⸚⸛⸜⸝⸞⸟⸠⸡⸢⸣⸤⸥⸦⸧⸨⸩⸪⸫⸬⸭⸮⸰⸱⸲⸳⸴⸵⸶⸷⸸⸹⸺⸻⸼⸽⸾⸿⹀⹁⹂⹃⹄⹅⹆⹇⹈⹉⹊⹋⹌⹍⹎⹏⹐⹑⹒⹓⹔⹕⹖⹗⹘⹙⹚⹛⹜⹝⺀⺁⺂⺃⺄⺅⺆⺇⺈⺉⺊⺋⺌⺍⺎⺏⺐⺑⺒⺓⺔⺕⺖⺗⺘⺙⺛⺜⺝⺞⺟⺠⺡⺢⺣⺤⺥⺦⺧⺨⺩⺪⺫⺬⺭⺮⺯⺰⺱⺲⺳⺴⺵" +
        "⺶⺷⺸⺹⺺⺻⺼⺽⺾⺿⻀⻁⻂⻃⻄⻅⻆⻇⻈⻉⻊⻋⻌⻍⻎⻏⻐⻑⻒⻓⻔⻕⻖⻗⻘⻙⻚⻛⻜⻝⻞⻟⻠⻡⻢⻣⻤⻥⻦⻧⻨⻩⻪⻫⻬⻭⻮⻯⻰⻱⻲⻳⼀⼁⼂⼃⼄⼅⼆⼇⼈⼉⼊⼋⼌⼍⼎⼏⼐⼑⼒⼓⼔⼕⼖⼗⼘⼙⼚⼛⼜⼝⼞⼟⼠⼡⼢⼣⼤⼥⼦⼧⼨⼩⼪⼫⼬⼭⼮⼯⼰⼱⼲⼳⼴⼵⼶⼷⼸⼹⼺⼻⼼⼽⼾⼿⽀⽁" +
        "⽂⽃⽄⽅⽆⽇⽈⽉⽊⽋⽌⽍⽎⽏⽐⽑⽒⽓⽔⽕⽖⽗⽘⽙⽚⽛⽜⽝⽞⽟⽠⽡⽢⽣⽤⽥⽦⽧⽨⽩⽪⽫⽬⽭⽮⽯⽰⽱⽲⽳⽴⽵⽶⽷⽸⽹⽺⽻⽼⽽⽾⽿⾀⾁⾂⾃⾄⾅⾆⾇⾈⾉⾊⾋⾌⾍⾎⾏⾐⾑⾒⾓⾔⾕⾖⾗⾘⾙⾚⾛⾜⾝⾞⾟⾠⾡⾢⾣⾤⾥⾦⾧⾨⾩⾪⾫⾬⾭⾮⾯⾰⾱⾲⾳⾴⾵⾶⾷⾸⾹⾺⾻⾼⾽⾾⾿⿀⿁" +
        "⿂⿃⿄⿅⿆⿇⿈⿉⿊⿋⿌⿍⿎⿏⿐⿑⿒⿓⿔⿕⿰⿱⿲⿳⿴⿵⿶⿷⿸⿹⿺⿻、。〃〄〈〉《》「」『』【】〒〓〔〕〖〗〘〙〚〛〜〝〞〟〠〰〶〷〽〾〿゛゜゠・㆐㆑㆖㆗㆘㆙㆚㆛㆜㆝㆞㆟㇀㇁㇂㇃㇄㇅㇆㇇㇈㇉㇊㇋㇌㇍㇎㇏㇐㇑㇒㇓㇔㇕㇖㇗㇘㇙㇚㇛㇜㇝㇞㇟㇠㇡㇢㇣㈀㈁㈂㈃㈄㈅㈆㈇㈈" +
        "㈉㈊㈋㈌㈍㈎㈏㈐㈑㈒㈓㈔㈕㈖㈗㈘㈙㈚㈛㈜㈝㈞㈪㈫㈬㈭㈮㈯㈰㈱㈲㈳㈴㈵㈶㈷㈸㈹㈺㈻㈼㈽㈾㈿㉀㉁㉂㉃㉄㉅㉆㉇㉐㉠㉡㉢㉣㉤㉥㉦㉧㉨㉩㉪㉫㉬㉭㉮㉯㉰㉱㉲㉳㉴㉵㉶㉷㉸㉹㉺㉻㉼㉽㉾㉿㊊㊋㊌㊍㊎㊏㊐㊑㊒㊓㊔㊕㊖㊗㊘㊙㊚㊛㊜㊝㊞㊟㊠㊡㊢㊣㊤㊥㊦㊧㊨㊩㊪㊫㊬㊭㊮㊯㊰㋀㋁㋂㋃" +
        "㋄㋅㋆㋇㋈㋉㋊㋋㋌㋍㋎㋏㋐㋑㋒㋓㋔㋕㋖㋗㋘㋙㋚㋛㋜㋝㋞㋟㋠㋡㋢㋣㋤㋥㋦㋧㋨㋩㋪㋫㋬㋭㋮㋯㋰㋱㋲㋳㋴㋵㋶㋷㋸㋹㋺㋻㋼㋽㋾㋿㌀㌁㌂㌃㌄㌅㌆㌇㌈㌉㌊㌋㌌㌍㌎㌏㌐㌑㌒㌓㌔㌕㌖㌗㌘㌙㌚㌛㌜㌝㌞㌟㌠㌡㌢㌣㌤㌥㌦㌧㌨㌩㌪㌫㌬㌭㌮㌯㌰㌱㌲㌳㌴㌵㌶㌷㌸㌹㌺㌻㌼㌽㌾㌿㍀㍁㍂㍃" +
        "㍄㍅㍆㍇㍈㍉㍊㍋㍌㍍㍎㍏㍐㍑㍒㍓㍔㍕㍖㍗㍘㍙㍚㍛㍜㍝㍞㍟㍠㍡㍢㍣㍤㍥㍦㍧㍨㍩㍪㍫㍬㍭㍮㍯㍰㍱㍲㍳㍴㍵㍶㍷㍸㍹㍺㍻㍼㍽㍾㍿㎀㎁㎂㎃㎄㎅㎆㎇㎈㎉㎊㎋㎌㎍㎎㎏㎐㎑㎒㎓㎔㎕㎖㎗㎘㎙㎚㎛㎜㎝㎞㎟㎠㎡㎢㎣㎤㎥㎦㎧㎨㎩㎪㎫㎬㎭㎮㎯㎰㎱㎲㎳㎴㎵㎶㎷㎸㎹㎺㎻㎼㎽㎾㎿㏀㏁㏂㏃" +
        "㏄㏅㏆㏇㏈㏉㏊㏋㏌㏍㏎㏏㏐㏑㏒㏓㏔㏕㏖㏗㏘㏙㏚㏛㏜㏝㏞㏟㏠㏡㏢㏣㏤㏥㏦㏧㏨㏩㏪㏫㏬㏭㏮㏯㏰㏱㏲㏳㏴㏵㏶㏷㏸㏹㏺㏻㏼㏽㏾㏿䷀䷁䷂䷃䷄䷅䷆䷇䷈䷉䷊䷋䷌䷍䷎䷏䷐䷑䷒䷓䷔䷕䷖䷗䷘䷙䷚䷛䷜䷝䷞䷟䷠䷡䷢䷣䷤䷥䷦䷧䷨䷩䷪䷫䷬䷭䷮䷯䷰䷱䷲䷳䷴䷵䷶䷷䷸䷹䷺䷻䷼䷽䷾䷿꒐꒑꒒꒓";
    encMax = 4096;
    encMax = encMax * encMax - 1;
}

playervar Boolean tracksBusy!; // an export or import is running, the timeline and recording stay closed
playervar Number expProgress;
playervar String ioStatus;      // what the running export or import is doing, shown under its progress
playervar String expLine;
playervar String expPending;
playervar Number expStrings!;
playervar Number expStamp!;
playervar Number expChars!;     // chars written so far, where the next channel starts
playervar Number expHud!;       // the export's HUD text. not a local, a local is reset when a restarted export begins
globalvar Number exportCount!;  // exports this game, the inspector log keeps all of them

// string q of the stream, at q % TREE_STRINGS in its tree: 0, 1, 5 and 9 are outer strings, the rest inner
Boolean ExpOuter(Number q): q % TREE_STRINGS == 0 || q % TREE_STRINGS % 4 == 1;

void ExpLog(String s!) playervar "export - log"
{
    EnableInspectorRecording();
    LogToInspector(s);
    DisableInspectorRecording();
}

// conditions and actions that open the rule for importData entry e. it runs unless a higher stamp is already loaded,
// and a higher stamp than the loaded one clears the data first, so the parts of one export can run in any order
void ExpRuleHead(Number e!) playervar "export - rule head"
{
    ExpLog(<'*/ conditions { Global.importStamp <= <0>; } /*', expStamp>);
    ExpLog(<'*/ actions { If(Global.importStamp < <0>); Global.importData = Empty Array; Global.importParts = 0; /*', expStamp>);
    ExpLog(<'*/ Global.importStamp = <0>; End; Set Global Variable At Index(importData, <1>, Array( /*', expStamp, e>);
}

// the previous string is logged, with what closes it in its tree. an inner string ending its outer one closes it, the
// last of a tree closes the tree. a full importData entry ends its rule and the next entry starts a new one, the boundary
// is on one line so the timestamps between lines stay inside rules. entries hold exactly IMPORT_ARRAY trees, the import
// finds a char by its index
void ExpPush() playervar "export - push string"
{
    if (expStrings > 0)
    {
        Number pos! = (expStrings - 1) % TREE_STRINGS;
        // an outer string ends in "{0}{1}{2}". OSTW reads {0} in its own strings as a format slot, so the "{" are inserted.
        // a Custom String fills {0}, {1}, {2} one after another, and a later slot also fills its token in text an earlier
        // one inserted, so the "{" go in through {2}, the last. OSTW drops and renumbers slots its text doesnt use
        if (ExpOuter(expStrings - 1))
            ExpLog(<'<0>Custom String(\"<1><2>0}<2>1}<2>2}\", /*', "*/ ", expPending, "{">);
        else if (pos != TREE_STRINGS - 1)
            ExpLog(<'*/ Custom String(\"<0>\")<1>, /*', expPending, pos % 4 == 0 ? ")" : "">);
        else if (expStrings % (TREE_STRINGS * IMPORT_ARRAY) != 0)
            ExpLog(<'*/ Custom String(\"<0>\"))), /*', expPending>);
        else
        {
            ExpLog(<'*/ Custom String(\"<0>\"))))); } } rule(\"[IMPORT <1>] part <2>\") { event { Ongoing - Global; } /*', expPending, expStamp,
                expStrings / (TREE_STRINGS * IMPORT_ARRAY) + 1>);
            ExpRuleHead(expStrings / (TREE_STRINGS * IMPORT_ARRAY));
        }
    }
    expPending = expLine;
    expLine = "";
    expStrings++;
    MinWait();
}

// appends s to the stream, a full string is pushed and the rest goes on in the next
void ExpAppend(String s!) playervar "export - append"
{
    expChars += StringLength(s);

    while (true)
    {
        Number room! = (ExpOuter(expStrings) ? 119 : 128) - StringLength(expLine);
        if (StringLength(s) < room)
            break;
        expLine = expLine + StringSlice(s, 0, room);
        s = StringSlice(s, room, StringLength(s) - room);
        ExpPush();
    }
    
    expLine = expLine + s;
}

void ExpPut(Number[] v!, Number width!) playervar "export - put"
{
    String s! = "";

    for (Number k! = 0; k < v.Length; k++)
        s = s + (width == 1 ? charTable.CharAt(v[k]) : charTable.CharAt(Floor(v[k] / 4096)) + charTable.CharAt(v[k] % 4096));

    ExpAppend(s);
}

// keys of the track in recTake, expN frames. the channel being written, and its last key as the import reconstructs it
playervar Number expN!;
playervar Number expCh!;        // Chan.Pos or Chan.Look
playervar Number expKf!;        // frame of the last key, -1 before the first
playervar Vector expKv!;
playervar Vector expV!;         // value read by ExpRead
playervar Vector expT!;         // and its tolerance per axis
playervar Vector expQ!;         // delta step per axis of the channel
playervar Vector expLo!;        // slopes (per frame, per axis) a key on the current frame may take so every frame since
playervar Vector expHi!;        // the last key stays within tolerance. the curve is cut when they cross
playervar Number expDone!;      // frames encoded, for the progress
playervar Number expTotal!;

void ExpTick() playervar "export - tick"
{
    expDone++;
    if (expDone % EXPORT_PER_TICK == 0)
    {
        expProgress = Floor(expDone / expTotal * 100);
        MinWait();
        WaitUntil(ServerLoad() < EXPORT_MAX_LOAD, 2);
    }
}

Vector ExpInSteps(Vector d): Vector(d.X / expQ.X, d.Y / expQ.Y, d.Z / expQ.Z);

// frame s of channel expCh into expV and its tolerance into expT. yaw is taken around the last keys, so a curve never
// wraps. position is held tight on frames recorded on the ground, on a slope a horizontal error is also a height error
void ExpRead(Number s!) playervar "export - read"
{
    tickI = Floor(s / CHUNK_SIZE);
    tickJ = s % CHUNK_SIZE;
    expV = expCh == Chan.Pos ? recTake[tickI][tickJ].Pos : Vector(expKv.X + Wrap(recTake[tickI][tickJ].Look.X - expKv.X), recTake[tickI][tickJ].Look.Y, 0);
    expT = expCh == Chan.Look
        ? Vector(ANG_TOL, ANG_TOL, 0)
        : HasBit(recTake[tickI][tickJ].Ctrl.Y, Bit.Ground)
            ? Vector(GROUND_TOL_XZ, GROUND_TOL, GROUND_TOL_XZ)
            : Vector(POS_TOL, POS_TOL, POS_TOL);
}

// key on frame f with value v. a delta from the last key takes 1 char per axis, a value out of its range is written
// absolute. expKv is computed the way the import computes it, so the next delta starts from what the import has
void ExpKey(Number f!, Vector v!) playervar "export - key"
{
    Vector st! = ExpInSteps(v - expKv);
    st = Vector(Near(st.X), Near(st.Y), Near(st.Z));
    Boolean abs! = expKf < 0 || MaxAbs(st) > 2047;
    ExpPut([f - Max(expKf, 0) + (abs ? 2048 : 0)], 1);
    if (!abs)
    {
        ExpPut([st.X + 2048, st.Y + 2048, st.Z + 2048].Slice(0, 3 - expCh), 1);
        expKv += Vector(st.X * expQ.X, st.Y * expQ.Y, st.Z * expQ.Z);
    }
    else
    {
        // position in 1/4096 m over the world range, facing as yaw and pitch over their range
        Vector a! = expCh == Chan.Pos
            ? Vector(Quant(v.X), Quant(v.Y), Quant(v.Z))
            : Vector(Near((Wrap(v.X) + 180) / 360 * encMax), Near((v.Y + 90) / 180 * encMax), 0);
        ExpPut([a.X, a.Y, a.Z].Slice(0, 3 - expCh), 2);
        expKv = expCh == Chan.Pos ? DecodePos(a) : DecodeLook(expKv.X, a.X, a.Y);
    }
    expKf = f;
}

// position or facing (c) as a curve. each frame narrows the slopes a key on it may take (swinging door), when
// none is left the previous frame gets a key in the middle of what was left, so every frame between keys is within
// tolerance of the line through them. a frame a delta cant reach (teleport, flick) gets an absolute key of its own
void ExpCurve(Number | Chan c!) playervar "export - curve"
{
    expCh = c;
    expQ = c == Chan.Pos ? Vector(POS_STEP, POS_STEP_Y, POS_STEP) : Vector(ANG_STEP, ANG_STEP, ANG_STEP);
    expKf = -1;
    expKv = Vector(0, 0, 0);
    ExpRead(0);
    ExpKey(0, expV);
    expLo = Vector(-OPEN, -OPEN, -OPEN);
    expHi = Vector(OPEN, OPEN, OPEN);
    ExpTick();

    for (Number s! = 1; s < expN; s++)
    {
        ExpRead(s);
        Number d! = s - expKf;
        Vector lo! = (expV - expT - expKv) / d;
        Vector hi! = (expV + expT - expKv) / d;
        lo = Vector(Max(expLo.X, lo.X), Max(expLo.Y, lo.Y), Max(expLo.Z, lo.Z));
        hi = Vector(Min(expHi.X, hi.X), Min(expHi.Y, hi.Y), Min(expHi.Z, hi.Z));

        if (MaxAbs(ExpInSteps(expV - expKv)) > DELTA_LIM || d > KEY_GAP_MAX || lo.X > hi.X || lo.Y > hi.Y || lo.Z > hi.Z)
        {
            if (s - 1 > expKf)
            {
                ExpKey(s - 1, expKv + (expLo + expHi) / 2 * (s - 1 - expKf));
                ExpRead(s);
            }
            if (MaxAbs(ExpInSteps(expV - expKv)) > DELTA_LIM)
            {
                ExpKey(s, expV);
                expLo = Vector(-OPEN, -OPEN, -OPEN);
                expHi = Vector(OPEN, OPEN, OPEN);
            }
            else
            {
                expLo = expV - expT - expKv;
                expHi = expV + expT - expKv;
            }
        }
        else
        {
            expLo = lo;
            expHi = hi;
        }
        ExpTick();
    }
    if (expN - 1 > expKf)
        ExpKey(expN - 1, expKv + (expLo + expHi) / 2 * (expN - 1 - expKf));
}

void ExportTracks() playervar "export - export"
{
    Number expHudProg!;
    StopAll();
    StoreTrackFlags(focusedTrack, flags);
    Number[] ids! = TRACK_IDS.Filter(t => trackFrames[t] > 0);
    if (ids.Length == 0)
    {
        SmallMessage(player, "Nothing to export, record something first");
        return;
    }

    // an export started during the last ones final wait restarts this, the last ones text is still up
    if (expProgress < 0)
        DestroyHudText(expHud);

    tracksBusy = true;
    expProgress = 0;
    CloseTimeline();
    CreateHudText(
        VisibleTo:      player,
        Text:           local.expProgress >= 0
                            ? <" \n\n\nExporting <0>%", local.expProgress>
                            : exportCount > 1
                                ? " \n\n\nExported!\n1. Open Inspector\n2. Click \"copy to clipboard all log\"\n3. Delete all before last DELETE line\n4. Paste into lobby"
                                : " \n\n\nExported!\n1. Open Inspector\n2. Click \"copy to clipboard all log\"\n3. Delete the first timestamp\n4. Paste rule(s) into lobby",
        Location:       Location.Top,
        SortOrder:      1,
        TextColor:      Color.White,
        Reevaluation:   HudTextRev.VisibleToAndString,
        Spectators:     Spectators.VisibleNever);
    expHud = LastTextID();
    CreateProgressBarHudText(
        VisibleTo:        player,
        Value:            local.expProgress,
        Text:             local.ioStatus,
        Location:         Location.Top,
        SortOrder:        2,
        ProgressBarColor: Color.White,
        Reevaluation:     ProgressBarHudEvaluation.VisibleToAndValues);
    expHudProg = LastTextID();
    ioStatus = "Writing the rule header";

    Number frames! = 0;
    String heroes! = "";
    for (Number k! = 0; k < ids.Length; k++)
    {
        frames += trackFrames[ids[k]];
        heroes = k == 0 ? <"<0>", trackHero[ids[k]]> : <"<0>, <1>", heroes, trackHero[ids[k]]>;
    }
    expDone = 0;
    expTotal = frames * 3;

    // rule title, every rule of the export keeps the stamp so its parts can be told apart from other export parts
    expStamp = Near(Time() * 10);
    String title! = <"[IMPORT <0>] <1> track<2>, <3> long, <4> frames, <5>", expStamp, ids.Length, ids.Length == 1 ? "" : "s",
        FormattedFrameToSec(timelineFrames), frames, CurrentMap()>;
    if (StringLength(title) + StringLength(heroes) + 3 <= 128)
        title = <"<0> | <1>", title, heroes>;

    expLine = "";
    expPending = "";
    expStrings = 0;
    expChars = 0;

    if (exportCount > 0)
        ExpLog("/* ================================= !!!! DELETE EVERYTHING RIGHT BEFORE THIS COMMENT !!!! ================================== /*");

    ExpLog(<'<0>rule(\"<1>\") { event { Ongoing - Global; } /*', exportCount > 0 ? "*/ " : "", title>);
    exportCount++;
    ExpRuleHead(0);

    ExpPut([focusedTrack, ids.Length], 1);
    ExpPut([trimStart, trimEnd], 2);

    Number[] dir! = [];
    for (Number k! = 0; k < ids.Length; k++)
    {
        Number t! = ids[k];
        ioStatus = <"Track <0> <1>: flags", t + 1, trackHero[t]>;

        ExpPut([t, AllHeroes().IndexOf(trackHero[t]), trackTeam[t]], 1);
        ExpPut([trackStart[t], trackFrames[t]], 2);

        Number[] flagList! = TrackFlagList(t);
        ExpPut([flagList.Length], 1);
        ExpPut(flagList, 2);

        // the tracks samples, staged once (recording is blocked while exporting, nothing else uses recTake then)
        LoadTrackStage(t);
        expN = trackFrames[t];
        ioStatus = <"Track <0> <1>: positions", t + 1, trackHero[t]>;
        ExpCurve(Chan.Pos);
        dir += expChars;
        ioStatus = <"Track <0> <1>: aim", t + 1, trackHero[t]>;
        ExpCurve(Chan.Look);
        dir += expChars;
        ioStatus = <"Track <0> <1>: buttons, movement and health", t + 1, trackHero[t]>;

        // buttons, throttle and health, a key whenever one changes
        Vector last! = Vector(-1, -1, -1);
        Number lastHp! = -1;
        expKf = 0;
        for (Number s! = 0; s < expN; s++)
        {
            tickI = Floor(s / CHUNK_SIZE);
            tickJ = s % CHUNK_SIZE;
            Vector ctrl! = recTake[tickI][tickJ].Ctrl;
            Number hp! = recTake[tickI][tickJ].Look.Z;
            Vector v! = Vector(Near((ctrl.X + 1) * 2047.5), ctrl.Y, Near((ctrl.Z + 1) * 2047.5));

            if (v != last || hp != lastHp || s == expN - 1 || s - expKf >= KEY_GAP_MAX)
            {
                ExpPut([s - expKf], 1);
                if (hp != lastHp)
                    ExpPut([v.Y + HEALTH_FLAG, Min(Near(hp * 1024), encMax)], 2);
                else
                    ExpPut([v.Y], 2);
                ExpPut([v.X, v.Z], 1);
                expKf = s;
                last = v;
                lastHp = hp;
            }
            ExpTick();
        }
    }
    recTake = []; // the staged track would stay as stored data on top of the tracks

    ioStatus = "Writing the track directory";

    // the last tree is filled up so the directory ends it, its last string is then pushed and pending. String Slice
    // returns at most 128 chars, so the filler goes in pieces
    Number pad! = (TREE_CHARS - (expChars + dir.Length * 2) % TREE_CHARS) % TREE_CHARS;
    while (pad > 0)
    {
        ExpAppend(StringSlice(charTable, 0, Min(pad, 128)));
        pad -= 128;
    }
    ExpPut(dir, 2);

    ExpLog(<'*/ Custom String(\"<0>\"))))); Global.importMap = Custom String(\"<1>\"); Global.importParts = <2>; } }', expPending, CurrentMap(),
        Floor((expStrings - 1) / (TREE_STRINGS * IMPORT_ARRAY)) + 1>);

    tracksBusy = false;
    expProgress = -1;
    DestroyProgressBarHudText(expHudProg);
    Wait(15);
    DestroyHudText(expHud);
    expProgress = 0;
}
