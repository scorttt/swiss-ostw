import "../main.del";

// DISCLAIMER: export / import has been assisted with AI for swinging door compression, code is partially converted from a simpler export/import process

// recordings are exported through the Inspector log as pasteable vanilla Workshop rules, one per IMPORT_ARRAY trees
// (a rule cant be pasted above 98 KB). each rule fills its own importData entry with trees of charTable characters
// (2 chars = 24 bits = float32s exact integer range), and "import recordings" decodes them into the hosts
// tracks at game start, replacing theirs. the stamp (game time of the export) identifies an export: a part runs unless a
// higher stamp is already loaded, and a higher stamp than the loaded one clears importData first. so an exports parts
// load in any order, and with several pasted exports the highest stamp wins. the last part stores the part count, so a
// missing part is reported instead of imported. stamps from different lobbies dont compare, its an identifier, not an age
//
// a tree is a Custom String of 119 chars with "{0}{1}{2}" after them, its 3 slots each another one like it, and their
// slots strings of 128 chars: 4 outer and 9 inner strings, TREE_CHARS chars. in game an outer string costs 2 elements and
// an inner one 5 (1 per empty slot), ~20% more chars per element than plain 128 char strings. the stream fills the
// strings in the order the tree reads them, which is also the order they're written in (outer text first). the last tree
// is filled up so the directory ends it, every tree is full
//
// a track is written as keys instead of every frame. values are
// written in groups of the same width (ExpPut / ImpAt), stream:
//   focused trackCount (1 char each), trimStart trimEnd (2), then per track:
//   track hero team (1), start frames (2), flagCount (1), flags (2), then the tracks 3 channels one after another:
//   position and facing: curves within POS_TOL / ANG_TOL, interpolated linearly between keys on import. a key is a gap
//     char (frames since the last key, +2048 when absolute values follow), then 1 char per axis (delta from the last
//     key in POS_STEP / POS_STEP_Y / ANG_STEP steps, +2048) or 2 chars per axis absolute (first key, teleports, flicks).
//     position on frames recorded on the ground stays within GROUND_TOL / GROUND_TOL_XZ: a bot forced a few mm above
//     or into the floor (or a slope) flickers between airborne and grounded
//   steps: a key whenever buttons, throttle or health change. gap (1), buttons (2, +HEALTH_FLAG when health follows),
//     [health * 1024 (2)], throttle x z (1)
//   every channel has a key on frame 0 and on the last frame, gaps stay under 2048
// then a directory: facing and steps start (2 chars each) of every track, so the import reads the 3 channels at once
// positions cover the fixed world range -2048 to 2048 in 1/4096 m steps (0.24 mm), maps fit well inside it

// channels of a track, and the cursors the import reads them with (impCur)
enum Chan
{
    Pos,
    Look,
    Steps,
    Header
}

globalvar String charTable;      // 4096 visible symbol/punctuation chars. plain, too large to sit in the ! values that are written often
globalvar Number encMax!;        // 4096^2 - 1, built at runtime since big literals get clamped

Number IMPORT_ARRAY:    15;     // trees per importData entry and per pasted rule, a rule cant be pasted above ~98 KB (15 is ~76 KB)
Number TREE_CHARS:      1628;   // chars per tree, 4 outer strings of 119 and 9 inner of 128
Number TREE_STRINGS:    13;
Number ENTRY_CHARS:     24420;  // IMPORT_ARRAY * TREE_CHARS, every entry but the last is full
Number EXPORT_PER_TICK: 8;
Number EXPORT_MAX_LOAD: 225;    // server load % the export waits under
Number HEALTH_FLAG:     32768;  // buttons bit: health follows, only export when it changes

Number POS_TOL:   0.0057;       // m per axis, ~1 cm overall
Number POS_STEP:  0.001;        // m per delta step
Number POS_STEP_Y: 0.000244140625;  // height steps are 1/4096 m, the absolute grid, so a height on the ground repeats exactly
Number GROUND_TOL: 0.0002;      // m, height on frames recorded on the ground
Number GROUND_TOL_XZ: 0.001;    // m, horizontal on frames recorded on the ground
Number ANG_TOL:   0.01;         // degrees, aim kept as close as the delta steps allow
Number ANG_STEP:  0.01;
Number DELTA_LIM: 2000;         // steps a key may be from the last one before the curve is cut, 1 char holds -2048 to 2047
Number KEY_GAP_MAX: 2047;
Number OPEN:      100000;       // slope bounds of an empty door

Number WORLD_HALF: 2048;
Number Quant(Number v): Clamp(Near((v + WORLD_HALF) * 4096), 0, encMax);
Number Wrap(Number a): a - Near(a / 360) * 360;     // angle into -180 to 180
Number MaxAbs(Vector v): Max(Abs(v.X), Max(Abs(v.Y), Abs(v.Z)));

// absolute keys as the import decodes them, the export uses the same so its next delta starts from what the import has
Vector DecodePos(Vector a): a / 4096 - Vector(WORLD_HALF, WORLD_HALF, WORLD_HALF);
Vector DecodeLook(Number prevYaw, Number yaw, Number pitch): Vector(prevYaw + Wrap(yaw / encMax * 360 - 180 - prevYaw), pitch / encMax * 180 - 90, 0);

