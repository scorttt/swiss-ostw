import "main.del";
Number delta: 0.016; // length of each "frame" as wait durations. must be a multiple of 0.016 TODO: make this player adjustable as a framerate option: 1/delta

Number TRACK_HALF:  2.60; // timeline track spans -TRACK_HALF to TRACK_HALF on the menu x axis
Number TRACK_WIDTH: 5.2;
Number TOOLTIP_Y:   -1.25;

Number BUTTON_ROW_Y_MIN: -1.15;
Number BUTTON_ROW_Y_MAX: -1.05;

Number HANDLE_Y_MIN:     -0.80;
Number HANDLE_Y_MAX:     -0.725;
Number HANDLE_HALF_W:    0.0375;
Number HANDLE_MIN_GAP:   0.05;
Number HANDLE_X_OFFSET:  0.003;

Number SEEKER_Y_MIN: -0.975;
Number SEEKER_Y_MAX: -0.825;

Number SCREEN_WIDTH:  3.65;
Number SCREEN_HEIGHT: 2.125;

Number ANIM_HIDDEN_Y: -2.9;
Number ANIM_SPEED:   0.15;

globalvar Number[] CTRL_X;                  // text x position
globalvar Number[] TIMELINE_CTRL_Y_POS;     // text y position when the menu is open
globalvar Number[] CTRL_HIT_X_MIN;          // hitbox
globalvar Number[] CTRL_HIT_X_MAX;
globalvar Number[] CTRL_HIT_Y_MIN;
globalvar Number[] CTRL_HIT_Y_MAX;

globalvar Number[] TIMELINE_UI_Y_POS;

playervar Vector facing;            // cursor math facing vector to compare
playervar Boolean timelineOpen;
playervar Number hoveredCtrl;       // hovered control item (Ctrl)
playervar Number[] timelineCtrlYPos;
playervar Number[] timelineUiYPos;

playervar Boolean animating;
playervar Boolean closing;

playervar Boolean playbackActive;   // any form of playback bool
playervar Boolean playing;          // normal playback bool
playervar Boolean rewinding;        // rewind bool
playervar Boolean fastForwarding;   // fast forward bool
playervar Boolean recording;        // recording bool
playervar Number framesToSkip;      // how many frames to skip per tick during rewind/fast forward

playervar Number dragTarget;

playervar Number totalFrames;       // recording length, only set by SetRecordingLength
playervar Number trimStart;         // trimmed playback start frame
playervar Number trimEnd;           // trimmed playback end frame
playervar Number currFrame;
playervar Number[] flags;
playervar Number hoverFlagIndex;

// clickable items, fills CTRL_
enum Ctrl
{
    Invalid = -1,
    Play = 0,
    Pause = 1,
    Stop = 2,
    Rewind = 3,
    Forward = 4,
    ToStart = 5,
    ToEnd = 6,
    PrevFrame = 7,
    NextFrame = 8,
    Options = 9,
    Record = 10,
    Track = 11,
    AddFlag = 12
}

// non-clickable items, fills TIMELINE_UI_Y_POS
enum Ui
{
    CurrFrame,
    ProgressBar,
    Seeker,
    Handles,
    HandleTime,
    FrameMult,
    Flags,
    TimeElapsed,
    FlagCount
}

enum Drag
{
    None,
    Seeker,
    LHandle,
    RHandle
}

enum Cursor 
{ 
    Default, 
    Drag,
    FlagHover 
}

Color HoverPulse():
    CustomColor(Oscillate(500, 0, 136), Oscillate(500, 153, 219), 255, 255);
Color RecordingPulse():
    CustomColor(Oscillate(500, 180, 255), 0, 0, 255);
Color DisabledButtonColor(): CustomColor(140, 140, 140, 255);

Number CursorX(Player p = local): AngleDifference(HorizontalAngleFromDirection(Facing(p)), HorizontalAngleFromDirection(p.facing));
Number CursorY(Player p = local): AngleDifference(VerticalAngleFromDirection(Facing(p)), VerticalAngleFromDirection(p.facing));

String PrettyNumber(Number | String number):
        StringLength(number) <= 3
            ? number
            : StringLength(number) <= 6
                ? StringSlice(number, 0, StringLength(number) - 3) + "," + StringSlice(number, StringLength(number) - 3, 3)
                : StringSlice(number, 0, StringLength(number) - 6) + "," + StringSlice(number, StringLength(number) - 6, 3) + "," + StringSlice(number, StringLength(number) - 3, 3);
                // supports only 9 digits, no one will ever need more than that since at worst that would be over half a year of recording (999,999,999 * 0.016 = 185 days)

Vector MenuYFromMenuZ(Vector z): DirectionFromAngles(HorizontalAngleFromDirection(z), VerticalAngleFromDirection(z) - 90);
Any RenderPosOf(Number x = 0, Number y = 0):
    Update(EyePos(local) + 100 * (x * Cross(Facing(local), MenuYFromMenuZ(Facing(local))) + y * MenuYFromMenuZ(Facing(local)) + 3 * Facing(local)));

Number FrameToSeconds(Number f): f * delta;

Number FRAMES_PER_MINUTE: 3750;
Number FRAMES_PER_HOUR: 225000;
String FormattedFrameToSec(Number f): <"<0><1><2><3>",
                                            local.totalFrames >= FRAMES_PER_HOUR // hours
                                                ? <"<0>:", Floor(FrameToSeconds(f) / 3600)>
                                                : "",
                                            local.totalFrames >= FRAMES_PER_MINUTE // minutes
                                                ? ((FrameToSeconds(f) >= 3600 || local.totalFrames >= FRAMES_PER_HOUR) && FrameToSeconds(f) % 3600 / 60 < 10)
                                                        ? <"0<0>:", Floor(FrameToSeconds(f) / 60) % 60>
                                                        : <"<0>:", Floor(FrameToSeconds(f) / 60) % 60>
                                                : "",
                                            Floor(FrameToSeconds(f) % 60) < 10  // seconds
                                                ? "0"
                                                : "",
                                            FrameToSeconds(f) % 60 + 0.0001>; // miliseconds, add small offset so overwatch doesnt hide decimal. this is stupid

Number ThrottleX(Player p = player): ThrottleOf(p).X;
Boolean TimelineVisible(): local.timelineOpen || local.closing;
Boolean IsHovered(Number | Ctrl id): local.hoveredCtrl == id;
Boolean IsDragging(Player p = local): p.dragTarget != Drag.None;
Number FrameToFraction(Number f, Player p = local): f / p.totalFrames;
Number FrameToTrackX(Number f, Player p = local):   FrameToFraction(f, p) * TRACK_WIDTH - TRACK_HALF;
Number TrackXToFrame(Number x, Player p = local):   Floor(p.totalFrames * NormalizedRange(Clamp(x, -TRACK_HALF, TRACK_HALF), -TRACK_HALF, TRACK_HALF));
Number TrimStartX(Player p = local):                FrameToTrackX(p.trimStart, p);
Number TrimEndX(Player p = local):                  FrameToTrackX(p.trimEnd, p);

Any CtrlPos(Number | Ctrl id, Number xOffset = 0, Number yOffset = 0): RenderPosOf(CTRL_X[id] + xOffset, local.timelineCtrlYPos[id] + yOffset);
Any UiPos(Number x, Number | Ui id, Number yOffset = 0): RenderPosOf(x, local.timelineUiYPos[id] + yOffset);
Any TipPos(Number | Ctrl id): RenderPosOf(CTRL_X[id], TOOLTIP_Y);
Any CursorState(Player p = local): IsDragging(p) ? Cursor.Drag : p.hoverFlagIndex != -1 ? Cursor.FlagHover : Cursor.Default;

// (llm written) whether a button is usable, used for both color and hit testing
Boolean CtrlEnabled(Number | Ctrl c, Player p = local):
    c == Ctrl.Record
        ? true
        : c == Ctrl.AddFlag
            ? p.flags.Contains(p.currFrame) || p.flags.Length < MAX_FLAGS
            : p.recording
                ? false
                : c == Ctrl.Play
                    ? !p.playbackActive && p.currFrame != p.trimEnd
                    : c == Ctrl.Pause || c == Ctrl.Stop
                        ? p.playbackActive
                        : c == Ctrl.Rewind || c == Ctrl.ToStart || c == Ctrl.PrevFrame
                            ? p.currFrame != p.trimStart
                            : c == Ctrl.Forward || c == Ctrl.ToEnd || c == Ctrl.NextFrame
                                ? p.currFrame != p.trimEnd
                                : true;

// button text color, also used for some timeline actions (e.g. rewinding/fast forwarding)
Color ButtonColor(Number | Ctrl id, Boolean active = false):
    IsHovered(id) || active
        ? HoverPulse()
        : CtrlEnabled(id)
            ? Color.White
            : DisabledButtonColor();

globalvar String txCharacter;
String TXString(String value): "{0}TX {1}>".Format([txCharacter, value]);
rule: "init unsanitized text"
{
    # unsanitized string stuff for the menu cursor, might break in future updates
    CreateDummyBot(<Hero>AllHeroes(), <Team>host, false, null, null);
    StartForcingDummyBotName(LastCreatedEntity(), "______________________________________________________________________________________________________________________________〼");
    txCharacter = StringSplit(FirstOf(LastCreatedEntity()), EmptyArray());
    StartForcingDummyBotName(LastCreatedEntity(), "______________________________________________________________________________________________________________________________ࡀ");
    txCharacter = StringSlice(StringReplace("______________________________________________________________________________________________________________________________〼", txCharacter, FirstOf(LastCreatedEntity())), 126, true);
    DestroyAllDummyBots();
}

void SetRecordingLength(Number frames) playervar "TL Sub : Set Recording Length"
{
    // called whenever a recording's length is known (init, recording stopped, track switched)
    totalFrames = frames;
    trimStart = 0;
    trimEnd = frames;
    currFrame = Clamp(currFrame, 0, frames);
    flags = flags.Filter(f => f <= frames);
}

rule: "init player"
Event.OnPlayerJoin
{
    flags = [];
    currFrame = 0;
    SetRecordingLength(6000); 
    // TODO: replace with recording length once recording is implemented
    // each player spawns with 0 length, timeline scrubbing is unusable until a length is set
}

// registers a clickable button
void UIButton(Number | Ctrl id, Number x, Number y, Number hitSize, Number hitYMin = BUTTON_ROW_Y_MIN, Number hitYMax = BUTTON_ROW_Y_MAX)
{
    CTRL_X[id] = x;
    TIMELINE_CTRL_Y_POS[id] = y;
    CTRL_HIT_X_MIN[id] = x - hitSize / 2;
    CTRL_HIT_X_MAX[id] = x + hitSize / 2;
    CTRL_HIT_Y_MIN[id] = hitYMin;
    CTRL_HIT_Y_MAX[id] = hitYMax;
}

rule: "init timeline tables"
{
    // sorted by id order
    // UIButton(id,          x,      y,      hitSize [hitYMin, hitYMax])
    UIButton(Ctrl.Play,      -2.380, -1.150, 0.125);
    UIButton(Ctrl.Pause,     -2.385, -1.150, 0.125);
    UIButton(Ctrl.Stop,      -2.250, -1.150, 0.125);
    UIButton(Ctrl.Rewind,    -2.125, -1.150, 0.125);
    UIButton(Ctrl.Forward,   -2.000, -1.150, 0.100);
    UIButton(Ctrl.ToStart,   -1.900, -1.160, 0.100);
    UIButton(Ctrl.ToEnd,     -1.800, -1.160, 0.085);
    UIButton(Ctrl.PrevFrame, -1.700, -1.150, 0.115);
    UIButton(Ctrl.NextFrame, -1.600, -1.150, 0.085);
    UIButton(Ctrl.Options,    2.350, -1.275, 0.500, -1.275, -1.160);
    UIButton(Ctrl.Record,    -2.520, -1.150, 0.150);
    UIButton(Ctrl.Track,      2.315, -1.150, 0.500);
    UIButton(Ctrl.AddFlag,   -1.500, -1.160, 0.085);

    TIMELINE_UI_Y_POS =
    [
        -1.075,  // 0 curr frame
        -1.350,  // 1 progress bar
        -0.955,  // 2 seeker
        -0.800,  // 3 handles
        -0.725,  // 4 handle timestamp
        -1.1425, // 5 frame multiplier
        -0.9575, // 6 flags
        -1.225,  // 7 time elapsed
        -1.075   // 8 flag count
    ];
}


// progress bar markers only apply to the currently focused hero recording (track)
// progress bar legend: // todo: add these when timeline is more feature complete
// ▼ - trim markers
// ● = flagged frame 
// IconString(Icon.Skull) = death
// ※ = kill
// ⊙ = respawn
// ◇ = objective lost/neutral
// ◈ = objective contested
// ◆ = objective captured
// Lucio Ability 2 = timescale adjusted
// 

rule: "create timeline text"
{
    // play
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && !local.playbackActive ? local : null,
        Header:         "▶",
        Position:       CtrlPos(Ctrl.Play),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.Play),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && (IsHovered(Ctrl.Play) || IsHovered(Ctrl.Pause)) ? local : null,
        Header:         !local.playbackActive
                            ? <"Play [<0>]", BindString(Button.Jump)>
                            : <"Pause [<0>]", BindString(Button.Jump)>,
        Position:       TipPos(Ctrl.Play),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // pause (two bars)
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && local.playbackActive ? local : null,
        Header:         "┃",
        Position:       CtrlPos(Ctrl.Pause, -0.020),
        Scale:          1.5,
        TextColor:      ButtonColor(Ctrl.Pause),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && local.playbackActive ? local : null,
        Header:         "┃",
        Position:       CtrlPos(Ctrl.Pause, 0.020),
        Scale:          1.5,
        TextColor:      ButtonColor(Ctrl.Pause),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    
    // record
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "●",
        Position:       CtrlPos(Ctrl.Record),
        Scale:          2,
        TextColor:      !local.recording ? ButtonColor(Ctrl.Record) : RecordingPulse(),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && (IsHovered(Ctrl.Record) || local.recording) ? local : null,
        Header:         IsHovered(Ctrl.Record) ? 
                            !local.recording ? "Start Recording [R x5]" : "Stop Recording [R x5]"
                        : "Recording",
        Position:       TipPos(Ctrl.Record),
        Scale:          1,
        TextColor:      !local.recording ? Color.White : RecordingPulse(),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    // record brackets
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && local.recording ? local : null,
        Header:         "[    ]",
        Position:       CtrlPos(Ctrl.Record, 0, -0.0050),
        Scale:          2,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    // text recording indicator outside tl 
    CreateInWorldText(
        VisibleTo:      local.recording && !TimelineVisible() ? local : null,
        Header:         "Recording Player Actions",
        Position:       RenderPosOf(0, 1.70),
        Scale:          1.5,
        TextColor:      RecordingPulse(),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // focused track
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "Track",
        Position:       CtrlPos(Ctrl.Track),
        Scale:          1.5,
        TextColor:      ButtonColor(Ctrl.Track),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    

    // stop
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "■",
        Position:       CtrlPos(Ctrl.Stop),
        Scale:          1.75,
        TextColor:      ButtonColor(Ctrl.Stop),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.Stop) ? local : null,
        Header:         <"Stop Playback [Crouch + <0>]", BindString(Button.Jump)>,
        Position:       TipPos(Ctrl.Stop),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // rewind
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "«",
        Position:       CtrlPos(Ctrl.Rewind),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.Rewind, local.rewinding),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.Rewind) ? local : null,
        Header:         <"Rewind [<0> + <1>]", BindString(Button.Ability1), BindString(Button.Ultimate)>,
        Position:       TipPos(Ctrl.Rewind),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // forward
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "»",
        Position:       CtrlPos(Ctrl.Forward),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.Forward, local.fastForwarding),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.Forward) ? local : null,
        Header:         <"Fast Forward [<0> + <1>]", BindString(Button.Ability1), BindString(Button.Ability2)>,
        Position:       TipPos(Ctrl.Forward),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // jump to start
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "≤",
        Position:       CtrlPos(Ctrl.ToStart),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.ToStart),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.ToStart) ? local : null,
        Header:         <"To Start [Crouch + <0>]", BindString(Button.Ultimate)>,
        Position:       TipPos(Ctrl.ToStart),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // jump to end
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "≥",
        Position:       CtrlPos(Ctrl.ToEnd),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.ToEnd),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.ToEnd) ? local : null,
        Header:         <"To End [Crouch + <0>]", BindString(Button.Ability2)>,
        Position:       TipPos(Ctrl.ToEnd),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // prev frame
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "‹",
        Position:       CtrlPos(Ctrl.PrevFrame),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.PrevFrame),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.PrevFrame) ? local : null,
        Header:         <"Previous Frame [<0>]", BindString(Button.Ultimate)>,
