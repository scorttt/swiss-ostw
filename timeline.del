        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.AddFlag) ? local : null,
        Header:         <"<0> Flag [<1>]", local.flags.Contains(local.currFrame) ? "Remove" : "Add", BindString(Button.Melee)>,
