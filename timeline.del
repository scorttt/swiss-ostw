import "main.del";
import "state.del";
import "recording.del";
import "playback.del";

Number TRACK_HALF:  2.60; // timeline track spans -TRACK_HALF to TRACK_HALF on the menu x axis
Number TRACK_WIDTH: 5.2;
Number TOOLTIP_Y:   -1.085;
Number TOOLTIP_SIZE: 0.9;

Number BUTTON_ROW_Y_MIN: -1.15;
Number BUTTON_ROW_Y_MAX: -1.05;

Number HANDLE_Y_MIN:     -0.80;
Number HANDLE_Y_MAX:     -0.725;
Number HANDLE_HALF_W:    0.0375;
Number HANDLE_MIN_GAP:   0.05;
Number HANDLE_X_OFFSET:  0.003;

Number SEEKER_Y_MIN: -0.975;
Number SEEKER_Y_MAX: -0.825;

Number SCREEN_WIDTH:  3.65;
Number SCREEN_HEIGHT: 2.125;

Number ANIM_HIDDEN_Y: -2.9;
Number ANIM_SPEED:   0.15;

globalvar Number[] CTRL_X;                  // text x position
globalvar Number[] TIMELINE_CTRL_Y_POS;     // text y position when the menu is open
globalvar Number[] CTRL_HIT_X_MIN;          // hitbox
globalvar Number[] CTRL_HIT_X_MAX;
globalvar Number[] CTRL_HIT_Y_MIN;
globalvar Number[] CTRL_HIT_Y_MAX;

globalvar Number[] TIMELINE_UI_Y_POS;

playervar Vector facing;            // cursor math facing vector to compare
playervar Boolean timelineOpen;
playervar Boolean trackMenuOpen;
playervar Number hoveredCtrl;       // hovered control item (Ctrl)
playervar Number[] timelineCtrlYPos;
playervar Number[] timelineUiYPos;

playervar Boolean animating;
playervar Boolean closing;

playervar Number dragTarget;

playervar Number hoverFlagIndex;
playervar Boolean confirmDelete;    // delete track clicked once, waiting for confirm click
playervar Boolean confirmRecord;    // record clicked once over an existing recording, waiting for confirm click

// clickable items, fills CTRL_
enum Ctrl
{
    Invalid = -1,
    Play = 0,
    Pause = 1,
    Stop = 2,
    Rewind = 3,
    Forward = 4,
    PrevFrame = 5,
    NextFrame = 6,
    Options = 7,
    Record = 8,
    Track = 9,
    AddFlag = 10,
    DeleteTrack = 11
}

// non-clickable items, fills TIMELINE_UI_Y_POS
enum Ui
{
    CurrFrame,
    ProgressBar,
    Seeker,
    Handles,
    HandleTime,
    FrameMult,
    Flags,
    TimeElapsed,
    FlagCount,
    TrackEnds
}

enum Drag
{
    None,
    Seeker,
    LHandle,
    RHandle
}

enum Cursor 
{ 
    Default, 
    Drag,
    FlagHover 
}

Color BluePulse():
    CustomColor(Oscillate(500, 0, 136), Oscillate(500, 153, 219), 255, 255);
Color RedPulse():
    CustomColor(Oscillate(500, 180, 255), 0, 0, 255);
Color WhiteYellowPulse():
    CustomColor(255, 255, Oscillate(500, 0, 255), 255);
Color DisabledColor(): CustomColor(140, 140, 140, 255);

playervar Number facingX;
playervar Number facingY;
Number CursorX(Player p = local): AngleDifference(HorizontalAngleFromDirection(Facing(p)), p.facingX);
Number CursorY(Player p = local): AngleDifference(VerticalAngleFromDirection(Facing(p)), p.facingY);

Any RenderPosOf(Number x = 0, Number y = 0):
    Update(EyePos(local) + 100 * (
        x * WorldVectorOf(Right(), local, LocalVector.Rotation)
      + y * Cross(Facing(local), WorldVectorOf(Left(), local, LocalVector.Rotation))
      + 3 * Facing(local)));

Number FrameToSeconds(Number f): f * delta;

Number FRAMES_PER_MINUTE: 3750;
Number FRAMES_PER_HOUR: 225000;
String FormattedFrameToSec(Number f): <"<0><1><2><3>",
                                            local.timelineFrames >= FRAMES_PER_HOUR // hours
                                                ? <"<0>:", Floor(FrameToSeconds(f) / 3600)>
                                                : "",
                                            local.timelineFrames >= FRAMES_PER_MINUTE // minutes
                                                ? ((FrameToSeconds(f) >= 3600 || local.timelineFrames >= FRAMES_PER_HOUR) && FrameToSeconds(f) % 3600 / 60 < 10)
                                                        ? <"0<0>:", Floor(FrameToSeconds(f) / 60) % 60>
                                                        : <"<0>:", Floor(FrameToSeconds(f) / 60) % 60>
                                                : "",
                                            Floor(FrameToSeconds(f) % 60) < 10  // seconds
                                                ? "0"
                                                : "",
                                            FrameToSeconds(f) % 60 + 0.0001>; // miliseconds, add small offset so overwatch doesnt hide decimal. this is stupid

Number ThrottleX(Player p = player): ThrottleOf(p).X;
Boolean TimelineVisible(): local.timelineOpen || local.closing;
Boolean IsHovered(Number | Ctrl id): local.hoveredCtrl == id;
Boolean IsDragging(Player p = local): p.dragTarget != Drag.None;
Number FrameToFraction(Number f, Player p = local): f / p.timelineFrames;
Number FrameToTrackX(Number f, Player p = local):   FrameToFraction(f, p) * TRACK_WIDTH - TRACK_HALF;
Number TrackXToFrame(Number x, Player p = local):   Floor(p.timelineFrames * NormalizedRange(Clamp(x, -TRACK_HALF, TRACK_HALF), -TRACK_HALF, TRACK_HALF));

Number TrimStartX(Player p = local):                FrameToTrackX(p.trimStart, p);
Number TrimEndX(Player p = local):                  FrameToTrackX(p.trimEnd, p);


playervar Boolean[] ctrlEnabled;
Boolean CtrlEnabled(Number | Ctrl c): local.ctrlEnabled[c];
Any CtrlPos(Number | Ctrl id, Number xOffset = 0, Number yOffset = 0): RenderPosOf(CTRL_X[id] + xOffset, local.timelineCtrlYPos[id] + yOffset);
Any UiPos(Number x, Number | Ui id, Number yOffset = 0): RenderPosOf(x, local.timelineUiYPos[id] + yOffset);
Any CtrlUiPos(Number | Ctrl id, Number | Ui ui, Number yOffset = 0): UiPos(CTRL_X[id], ui, yOffset);
Any CtrlMidUiPos(Number | Ctrl a, Number | Ctrl b, Number | Ui ui, Number yOffset = 0): UiPos((CTRL_X[a] + CTRL_X[b]) / 2, ui, yOffset); // ui information item centered between two buttons
Any TipPos(Number | Ctrl id): RenderPosOf(CTRL_X[id], TOOLTIP_Y);

Any CursorState(Player p = local): IsDragging(p) ? Cursor.Drag : p.hoverFlagIndex != -1 ? Cursor.FlagHover : Cursor.Default;
void UpdateCtrlEnabled() globalvar "Update Ctrl Enabled"
{
    ctrlEnabled = [
        !recording && !playbackActive && currFrame != trimEnd,  // Play
        !recording && playbackActive,                           // Pause
        !recording && playbackActive,                           // Stop
        !recording && currFrame != trimStart,                   // Rewind
        !recording && currFrame != trimEnd,                     // Forward
        !recording && currFrame != trimStart,                   // PrevFrame
        !recording && currFrame != trimEnd,                     // NextFrame
        !recording,                                             // Options
        true,                                                   // Record, always enabled
        !recording,                                             // Track
        (recording || recFrames > 0) && (flags.Contains(currFrame) || flags.Length < MAX_FLAGS), // AddFlag
        !recording && recFrames > 0                             // DeleteTrack
    ];
}

// button text color, also used for some timeline actions (e.g. rewinding/fast forwarding)
Color ButtonColor(Number | Ctrl id, Boolean active = false):
    IsHovered(id) || active
        ? BluePulse()
        : CtrlEnabled(id)
            ? Color.White
            : DisabledColor();

globalvar String txCharacter;
String TXString(String value): "{0}TX {1}>".Format([txCharacter, value]);
rule: "init unsanitized text"
{
    // unsanitized string stuff for the menu cursor, might break in future updates
    CreateDummyBot(<Hero>AllHeroes(), <Team>host, false, null, null);
    StartForcingDummyBotName(LastCreatedEntity(), "______________________________________________________________________________________________________________________________〼");
    txCharacter = StringSplit(FirstOf(LastCreatedEntity()), EmptyArray());
    StartForcingDummyBotName(LastCreatedEntity(), "______________________________________________________________________________________________________________________________ࡀ");
    txCharacter = StringSlice(StringReplace("______________________________________________________________________________________________________________________________〼", txCharacter, FirstOf(LastCreatedEntity())), 126, true);
    DestroyAllDummyBots();
}

rule: "init timeline player"
Event.OnPlayerJoin
{
    ctrlEnabled = [];
    hoverFlagIndex = -1;
    hoveredTrack = -1;
    hoveredOption = -1;
}

// registers a clickable button
void UIButton(Number | Ctrl id, Number x, Number y, Number hitSize, Number hitYMin = BUTTON_ROW_Y_MIN, Number hitYMax = BUTTON_ROW_Y_MAX) globalvar "UI Button"
{
    CTRL_X[id] = x;
    TIMELINE_CTRL_Y_POS[id] = y;
    CTRL_HIT_X_MIN[id] = x - hitSize / 2;
    CTRL_HIT_X_MAX[id] = x + hitSize / 2;
    CTRL_HIT_Y_MIN[id] = hitYMin;
    CTRL_HIT_Y_MAX[id] = hitYMax;
}

rule: "init timeline tables"
{
    // sorted by id order
    // UIButton(id,            x,      y,      hitSize [hitYMin, hitYMax])
    UIButton(Ctrl.Play,        -2.380, -1.150, 0.125);
    UIButton(Ctrl.Pause,       -2.385, -1.150, 0.125);
    UIButton(Ctrl.Stop,        -2.250, -1.150, 0.125);
    UIButton(Ctrl.Rewind,      -2.125, -1.150, 0.125);
    UIButton(Ctrl.Forward,     -2.000, -1.150, 0.100);
    UIButton(Ctrl.PrevFrame,   -1.900, -1.150, 0.115);
    UIButton(Ctrl.NextFrame,   -1.800, -1.150, 0.085);
    UIButton(Ctrl.Options,      2.350, -1.275, 0.500, -1.275, -1.160);
    UIButton(Ctrl.Record,      -2.520, -1.150, 0.150);
    UIButton(Ctrl.Track,        2.350, -1.150, 0.500);
    UIButton(Ctrl.AddFlag,     -1.700, -1.160, 0.085);
    UIButton(Ctrl.DeleteTrack, -1.590, -1.160, 0.085);

    TIMELINE_UI_Y_POS =
    [
        -1.200,  // 0 curr frame
        -1.350,  // 1 progress bar
        -0.955,  // 2 seeker
        -0.800,  // 3 handles
        -0.725,  // 4 handle timestamp
        -1.1425, // 5 frame multiplier
        -0.9575, // 6 flags
        -1.225,  // 7 time elapsed
        -1.200,  // 8 flag count
        -1.0825   // 9 track end markers
    ];
}

// progress bar markers only apply to the currently focused hero recording (track)
// progress bar legend: // todo: add these when timeline is more feature complete
// ▼ - trim markers
// ● = flagged frame 
// × = death
// ※ = kill
// ⊙ = respawn
// ◇ = objective lost/neutral
// ◈ = objective contested
// ◆ = objective captured
// Lucio Ability 2 = timescale adjusted
// 
// 

rule: "create timeline text"
{
    // todo: hidden texts still reeval, performance issues, need to rewrite tooltips to create only one text instead of for each button since only one tooltip is visible at a time
    // play
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && !local.playbackActive ? local : null,
        Header:         "▶",
        Position:       CtrlPos(Ctrl.Play),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.Play),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && (IsHovered(Ctrl.Play) || IsHovered(Ctrl.Pause)) ? local : null,
        Header:         !local.playbackActive
                            ? <"Play [<0>]", BindString(Button.Jump)>
                            : <"Pause [<0>]", BindString(Button.Jump)>,
        Position:       TipPos(Ctrl.Play),
        Scale:          TOOLTIP_SIZE,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // pause
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && local.playbackActive ? local : null,
        Header:         "I I", // font makes it display as 2 straight vertical lines
        Position:       CtrlPos(Ctrl.Pause, 0.007, -0.0075),
        Scale:          1.5,
        TextColor:      ButtonColor(Ctrl.Pause),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    
    // record
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "●",
        Position:       CtrlPos(Ctrl.Record),
        Scale:          2,
        TextColor:      local.recording || local.confirmRecord ? RedPulse() : ButtonColor(Ctrl.Record),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && (IsHovered(Ctrl.Record) || local.recording) ? local : null,
        Header:         !IsHovered(Ctrl.Record)
                            ? "Recording"
                            : local.recording
                                ? "Stop Recording [R x5]"
                                : local.confirmRecord
                                    ? "Replaces track, confirm?"
                                    : "Start Recording [R x5]",
        Position:       TipPos(Ctrl.Record),
        Scale:          TOOLTIP_SIZE,
        TextColor:      !local.recording ? Color.White : RedPulse(),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    // record brackets
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && local.recording ? local : null,
        Header:         "[    ]",
        Position:       CtrlPos(Ctrl.Record, 0, -0.0060),
        Scale:          2,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToAndPosition,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    // text recording indicator outside tl 
    CreateInWorldText(
        VisibleTo:      local.recording && !TimelineVisible() ? local : null,
        Header:         "Recording Player Actions",
        Position:       RenderPosOf(0, 1.70),
        Scale:          1.5,
        TextColor:      RedPulse(),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // focused track
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         <"Track <0>", local.focusedTrack + 1>,
        Position:       CtrlPos(Ctrl.Track),
        Scale:          1.5,
        TextColor:      ButtonColor(Ctrl.Track),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    

    // stop
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "■",
        Position:       CtrlPos(Ctrl.Stop),
        Scale:          1.75,
        TextColor:      ButtonColor(Ctrl.Stop),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.Stop) ? local : null,
        Header:         <"Stop Playback [Crouch + <0>]", BindString(Button.Jump)>,
        Position:       TipPos(Ctrl.Stop),
        Scale:          TOOLTIP_SIZE,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // rewind
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "«",
        Position:       CtrlPos(Ctrl.Rewind),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.Rewind, local.rewinding),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.Rewind) ? local : null,
        Header:         <"Rewind [<0> + <1>]", BindString(Button.Ability1), BindString(Button.Ultimate)>,
        Position:       TipPos(Ctrl.Rewind),
        Scale:          TOOLTIP_SIZE,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // forward
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "»",
        Position:       CtrlPos(Ctrl.Forward),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.Forward, local.fastForwarding),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.Forward) ? local : null,
        Header:         <"Fast Forward [<0> + <1>]", BindString(Button.Ability1), BindString(Button.Ability2)>,
        Position:       TipPos(Ctrl.Forward),
        Scale:          TOOLTIP_SIZE,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // prev frame
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "‹",
        Position:       CtrlPos(Ctrl.PrevFrame),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.PrevFrame),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.PrevFrame) ? local : null,
        Header:         <"Previous Frame [<0>]", BindString(Button.Ultimate)>,
        Position:       TipPos(Ctrl.PrevFrame),
        Scale:          TOOLTIP_SIZE,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // next frame
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "›",
        Position:       CtrlPos(Ctrl.NextFrame),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.NextFrame),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.NextFrame) ? local : null,
        Header:         <"Next Frame [<0>]", BindString(Button.Ability2)>,
        Position:       TipPos(Ctrl.NextFrame),
        Scale:          TOOLTIP_SIZE,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // current frame
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         <"<0>", local.currFrame>,
        Position:       CtrlMidUiPos(Ctrl.PrevFrame, Ctrl.NextFrame, Ui.CurrFrame),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // add/remove flag
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         local.flags.Contains(local.currFrame) ? "−" : "+",
        Position:       CtrlPos(Ctrl.AddFlag),
        Scale:          2,
        TextColor:      ButtonColor(Ctrl.AddFlag),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.AddFlag) ? local : null,
        Header:         IsAbility1Held(local) && local.flags.Length > 0
                                    ? <"Remove All Flags [<0> + <1>]", BindString(Button.Ability1), BindString(Button.Melee)>
                                    : <"<0> Flag [<1>]", local.flags.Contains(local.currFrame) ? "Remove" : "Add", BindString(Button.Melee)>,
        Position:       TipPos(Ctrl.AddFlag),
        Scale:          TOOLTIP_SIZE,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    // flag count
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         <"<0>/<1>", local.flags.Length, MAX_FLAGS>,
        Position:       CtrlUiPos(Ctrl.AddFlag, Ui.FlagCount),
        Scale:          1,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // delete focused track
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && HasRecording(local) ? local : null,
        Header:         "×",
        Position:       CtrlPos(Ctrl.DeleteTrack),
        Scale:          2,
        TextColor:      local.confirmDelete ? RedPulse() : ButtonColor(Ctrl.DeleteTrack),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    CreateInWorldText(
        VisibleTo:      local.timelineOpen && IsHovered(Ctrl.DeleteTrack) ? local : null,
        Header:         local.confirmDelete ? "Confirm Delete?" : "Delete Current Track",
        Position:       TipPos(Ctrl.DeleteTrack),
        Scale:          TOOLTIP_SIZE,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // options
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         "Options",
        Position:       CtrlPos(Ctrl.Options),
        Scale:          1.5,
        TextColor:      ButtonColor(Ctrl.Options),
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // progress bar
    CreateProgressBarInWorldText(
        VisibleTo:        TimelineVisible() ? local : null,
        Text:             "",
        Value:            FrameToFraction(local.currFrame) * 100,
        Position:         UiPos(0, Ui.ProgressBar),
        Scale:            3.2,
        ProgressBarColor: !local.recording ? Color.White : RedPulse(),
        Reevaluation:     ProgressBarWorldEvaluation.VisibleToPositionValuesAndColor,
        Clipping:         Clipping.DoNotClip);
    // time elapsed
    CreateInWorldText(
        VisibleTo:      TimelineVisible() ? local : null,
        Header:         TimelineHasFrames(local) ? FormattedFrameToSec(local.currFrame) : "Empty track",
        Position:       UiPos(0, Ui.TimeElapsed),
        Scale:          4,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // seeker
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && TimelineHasFrames(local) && !local.recording ? local : null,
        Header:         "┃",
        Position:       UiPos(FrameToTrackX(local.currFrame), Ui.Seeker),
        Scale:          2.75,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToAndPosition,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // left handle
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && TimelineHasFrames(local) && !local.recording ? local : null,
        Header:         "▼",
        Position:       UiPos(TrimStartX() - HANDLE_X_OFFSET, Ui.Handles),
        Scale:          2,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToAndPosition,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    // left handle min timestamp
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && TimelineHasFrames(local) && !local.recording ? local : null,
        Header:         FormattedFrameToSec(local.trimStart),
        Position:       UiPos(TrimStartX() - HANDLE_X_OFFSET, Ui.HandleTime),
        Scale:          0.65,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionAndString,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // right handle
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && TimelineHasFrames(local) && !local.recording ? local : null,
        Header:         "▼",
        Position:       UiPos(TrimEndX() - HANDLE_X_OFFSET, Ui.Handles),
        Scale:          2,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToAndPosition,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    // right handle max timestamp
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && TimelineHasFrames(local) && !local.recording ? local : null,
        Header:         FormattedFrameToSec(local.trimEnd),
        Position:       UiPos(TrimEndX() - HANDLE_X_OFFSET, Ui.HandleTime),
        Scale:          0.65,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionAndString,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // frame multiplier while fast forward/rewind
    CreateInWorldText(
        VisibleTo:      TimelineVisible() && (local.rewinding || local.fastForwarding) ? local : null,
        Header:         <"x<0>", local.framesToSkip>,
        Position:       UiPos(-2.0625, Ui.FrameMult),
        Scale:          0.75,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);

    // cursor
    CreateInWorldText(
        VisibleTo:      local.timelineOpen ? local : null,
        Header:         [TXString("C0000000002DD21"), "↔", "⊙"][CursorState()],
        Position:       RenderPosOf(
                            CursorX() + [ 0.07,  0,    0][CursorState()],
                            CursorY() + [-0.14, -0.07, -0.07][CursorState()]),
        TextColor:      Color.White,
        Scale:          2,
        Clipping:       Clipping.DoNotClip,
        Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor);
}

void StepAnim(Boolean closing) playervar "TL Sub : Step Anim"
{
    for (Number i = 0; i < TIMELINE_CTRL_Y_POS.Length; i++)
        timelineCtrlYPos[i] += ((closing ? ANIM_HIDDEN_Y : TIMELINE_CTRL_Y_POS[i]) - timelineCtrlYPos[i]) * ANIM_SPEED;

    for (Number i = 0; i < TIMELINE_UI_Y_POS.Length; i++)
        timelineUiYPos[i] += ((closing ? ANIM_HIDDEN_Y : TIMELINE_UI_Y_POS[i]) - timelineUiYPos[i]) * ANIM_SPEED;
}

rule: "open anim"
Event.OngoingPlayer
if (timelineOpen)
if (!closing)
{
    animating = true;

    while (timelineOpen && animating)
    {
        StepAnim(false);

        if (AlmostEqual(timelineUiYPos.Last, TIMELINE_UI_Y_POS.Last))
            break;

        MinWait();
    }

    animating = false;
}

rule: "close anim"
Event.OngoingPlayer
if (!timelineOpen)
{
    WaitUntil(!animating, 1);
    closing = true;
    animating = true;

    while (animating && closing)
    {
        StepAnim(true);

        if (AlmostEqual(timelineUiYPos.Last, ANIM_HIDDEN_Y))
            break;

        MinWait();
    }

    animating = false;
    closing = false;
}

////////////////////
//
// controls
//
////////////////////

Number CTRL_BAND_Y_MIN: -1.275; // lowest button hitbox (options)
Number CTRL_BAND_Y_MAX: -1.05;  // highest button hitbox

// all cursor hover detection in one loop, the regions dont overlap so only one is tested per tick
rule: "cursor hover"
Event.OngoingPlayer
if (timelineOpen)
{
    Number cX = CursorX(player);
    Number cY = CursorY(player);
    Number ctrlHit = -1;
    Number flagHit = -1;
    Number trackHit = -1;
    Number optionHit = -1;

    // keep the cursor inside the screen
    if (Abs(cX) > SCREEN_WIDTH || Abs(cY) > SCREEN_HEIGHT)
        SetFacing(Direction: DirectionFromAngles(
            Min(Max(facingX - cX, facingX - SCREEN_WIDTH / 1.01), facingX + SCREEN_WIDTH / 1.01),
            Min(Max(facingY - cY, facingY - SCREEN_HEIGHT / 1.01), facingY + SCREEN_HEIGHT / 1.01)));

    // button colors need this every tick, not just when hovering
    UpdateCtrlEnabled();

    // button row
    if (IsInRange(cY, CTRL_BAND_Y_MIN, CTRL_BAND_Y_MAX))
    {
        for (Number i = 0; i < CTRL_X.Length; i++)
        {
            if (ctrlEnabled[i]
                && IsInRange(cX, CTRL_HIT_X_MIN[i], CTRL_HIT_X_MAX[i])
                && IsInRange(cY, CTRL_HIT_Y_MIN[i], CTRL_HIT_Y_MAX[i]))
            {
                ctrlHit = i;
                break;
            }
        }
    }
    // flag markers
    else if (!IsDragging(player) && IsInRange(cY, TIMELINE_UI_Y_POS[Ui.Flags], TIMELINE_UI_Y_POS[Ui.Flags] + 0.10))
    {
        for (Number i = 0; i < flags.Length; i++)
        {
            if (Abs(FrameToTrackX(flags[i], player) - cX) < 0.015)
            {
                flagHit = i;
                break;
            }
        }
    }
    // track menu, evenly spaced rows so no loop
    else if (trackMenuOpen)
    {
        trackHit = Floor((TRACK_MENU_TOP_Y + TRACK_MENU_SPACING - cY) / TRACK_MENU_SPACING);
        if (Abs(cX) > TRACK_SLOT_HIT_WIDTH / 2 || !IsInRange(trackHit, 0, MAX_TRACKS - 1))
            trackHit = -1;
    }
    // options menu, evenly spaced grid so no loop
    else if (optionsMenuOpen)
    {
        Number col = Floor(cX / OPTIONS_COL_SPACING + OPTIONS_COLS / 2);
        Number row = Floor((OPTIONS_TOP_Y + OPTIONS_ROW_SPACING - cY) / OPTIONS_ROW_SPACING);
        if (IsInRange(col, 0, OPTIONS_COLS - 1) && IsInRange(row, 0, OPTIONS_ROWS - 1))
            optionHit = row * OPTIONS_COLS + col;
    }

    // only write on change
    if (hoveredCtrl != ctrlHit)
        hoveredCtrl = ctrlHit;
    if (hoverFlagIndex != flagHit)
        hoverFlagIndex = flagHit;
    if (hoveredTrack != trackHit)
        hoveredTrack = trackHit;
    if (hoveredOption != optionHit)
        hoveredOption = optionHit;

    // cancel confirmations when no longer hovering the button
    if (confirmDelete && ctrlHit != Ctrl.DeleteTrack)
        confirmDelete = false;
    if (confirmRecord && ctrlHit != Ctrl.Record)
        confirmRecord = false;

    MinWait();
    LoopIfConditionIsTrue();

    hoveredCtrl = -1;
    hoverFlagIndex = -1;
    hoveredTrack = -1;
    hoveredOption = -1;
    confirmDelete = false;
    confirmRecord = false;
}

void ActivateCtrl(Number | Ctrl ctrl) playervar "TL Sub : Selection Handler"
{
    if (recording && ctrl != Ctrl.Record && ctrl != Ctrl.AddFlag)
        return;

    switch (ctrl)
    {
        case Ctrl.Play:
            if (currFrame != trimEnd)
            {
                playbackActive = true;
                playing = true;
                fastForwarding = false;
                rewinding = false;
            }
            break;
        case Ctrl.Pause:
            StopAll();
            break;
        case Ctrl.Stop:
            StopAll();
            currFrame = trimStart;
            break;
        case Ctrl.Rewind:
            if (fastForwarding)
            {
                StopAll();
                break;
            }

            if (rewinding && framesToSkip != 32)
                framesToSkip *= 2;
            else if (!rewinding)
                framesToSkip = 2;

            if (currFrame != trimStart)
            {
                playbackActive = true;
                rewinding = true;
                playing = false;
            }
            break;
        case Ctrl.Forward:
            if (rewinding)
            {
                StopAll();
                break;
            }

            if (fastForwarding && framesToSkip != 32)
                framesToSkip *= 2;
            else if (!fastForwarding)
                framesToSkip = 2;

            if (currFrame != trimEnd)
            {
                playbackActive = true;
                fastForwarding = true;
                playing = false;
            }
            break;
        case Ctrl.PrevFrame:
            if (playbackActive)
                StopAll();

            if (currFrame > trimStart)
                currFrame--;
            break;
        case Ctrl.NextFrame:
            if (playbackActive)
                StopAll();

            if (currFrame < trimEnd)
                currFrame++;
            break;
        case Ctrl.AddFlag:
            ToggleFlag(currFrame);
            break;
        case Ctrl.Record:
            // confirm to overwrite an existing track
            if (!recording && HasRecording(player) && !confirmRecord)
            {
                confirmRecord = true;
                break;
            }

            confirmRecord = false;
            ToggleRecording();
            break;
        case Ctrl.Track:
            trackMenuOpen = !trackMenuOpen;
            optionsMenuOpen = false;
            break;
        case Ctrl.Options:
            optionsMenuOpen = !optionsMenuOpen;
            trackMenuOpen = false;
            break;
        case Ctrl.DeleteTrack:
            if (!confirmDelete)
            {
                confirmDelete = true;
                break;
            }

            confirmDelete = false;
            DeleteFocusedTrack();
            break;
    }
}

////////////////////
//
// timeline flagging
//
////////////////////

Number MAX_FLAGS: 8;
Number SNAP_DIST: 0.0175;
void ToggleFlag(Number frame) playervar "TL Sub : Toggle Flag"
{
    if (!recording && recFrames == 0)
        return;

    if (flags.Contains(frame))
        flags = flags - frame;
    else if (flags.Length < MAX_FLAGS)
        flags = flags + frame;
}

rule: "add/remove flag"
Event.OngoingPlayer
if (timelineOpen)
if (IsMeleeHeld() || IsPrimaryHeld() || IsSecondaryHeld())
{
    if (hoverFlagIndex != -1)
    {
        if (IsMeleeHeld() || IsSecondaryHeld())
            flags = RemoveFromArrayAtIndex(flags, hoverFlagIndex);
        else if (!recording)    
            currFrame = Clamp(flags[hoverFlagIndex], trimStart, trimEnd);
    }
    else if (IsMeleeHeld() && !IsAbility1Held())
    {
        ToggleFlag(currFrame);
    }

    WaitUntil(!IsMeleeHeld() && !IsPrimaryHeld() && !IsSecondaryHeld(), 99999);
}

rule: "remove all flags"
Event.OngoingPlayer
if (timelineOpen)
if (hoverFlagIndex != -1 || hoveredCtrl == Ctrl.AddFlag || (flags.Contains(currFrame) && IsMeleeHeld()) )
if (IsAbility1Held())
if (IsMeleeHeld() || IsSecondaryHeld())
{
    flags = [];
    WaitUntil(!IsMeleeHeld() && !IsSecondaryHeld(), 99999);
}

rule: "create flag markers"
{
    for (Number i = 0; i < MAX_FLAGS; i++)
    {
        CreateInWorldText(
            VisibleTo:      TimelineVisible() && local.flags.Length > Once(i) ? local : null,
            Header:         "I",
            Position:       UiPos(FrameToTrackX(local.flags[Once(i)]), Ui.Flags),
            Scale:          2,
            TextColor:      Color.Yellow,
            Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
            Clipping:       Clipping.DoNotClip,
            Spectators:     Spectators.VisibleNever);
    }
}

// end of each track on timeline
rule: "create track end markers"
{
    for (Number i = 0; i < MAX_TRACKS; i++)
    {
        CreateInWorldText(
            VisibleTo:      TimelineVisible() && TrackFrames(Once(i)) > 0 ? local : null,
            Header:         <" I\nT<0>", Once(i) + 1>,
            Position:       UiPos(FrameToTrackX(TrackEnd(Once(i))), Ui.TrackEnds),
            Scale:          1,
            TextColor:      local.focusedTrack == Once(i) ? BluePulse() : Color.White,
            Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
            Clipping:       Clipping.DoNotClip,
            Spectators:     Spectators.VisibleNever);
    }
}

////////////////////
//
// track menu
//
////////////////////

Number TRACK_MENU_TOP_Y:   0.55;
Number TRACK_MENU_SPACING: 0.10;
Number TRACK_SLOT_HIT_WIDTH:   1.40;

playervar Number hoveredTrack;
playervar Number[] trackMenuTexts;

playervar Boolean trackMenuCreated; // track menu texts finished creating, options menu waits on this

// created hidden when the timeline opens so opening the menu is instant, destroyed when the timeline closes
rule: "track menu"
Event.OngoingPlayer
if (timelineOpen)
{
    trackMenuTexts = [];

    CreateInWorldText(
        VisibleTo:      local.trackMenuOpen ? local : null,
        Header:         "Select Track",
        Position:       RenderPosOf(0, TRACK_MENU_TOP_Y + 0.15),
        Scale:          2,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToAndPosition,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    trackMenuTexts = trackMenuTexts + LastTextID();

    for (Number i = 0; i < MAX_TRACKS; i++)
    {
        if (!timelineOpen)
            break;

        CreateInWorldText(
            VisibleTo:      local.trackMenuOpen ? local : null,
            Header:         <"Track <0>   <1>",  
                                Once(i) + 1, 
                                TrackFrames(Once(i)) > 0 
                                    ? <"<0> <1> frames", HeroIconString(local.trackHero[Once(i)]), TrackFrames(Once(i))> 
                                    : "Empty">,
            Position:       RenderPosOf(0, TRACK_MENU_TOP_Y - (Once(i)) * TRACK_MENU_SPACING),
            Scale:          1.5,
            TextColor:      local.hoveredTrack == Once(i) ? BluePulse() : Color.White,
            Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
            Clipping:       Clipping.DoNotClip,
            Spectators:     Spectators.VisibleNever);
        trackMenuTexts = trackMenuTexts + LastTextID();
        MinWait();
    }

    trackMenuCreated = true;

    WaitUntil(!timelineOpen, 99999);

    for (Number i = 0; i < trackMenuTexts.Length; i++)
        DestroyInWorldText(trackMenuTexts[i]);

    trackMenuTexts = [];
    trackMenuCreated = false;
}

////////////////////
//
// options menu
//
////////////////////

Number OPTIONS_COLS:        3;
Number OPTIONS_ROWS:        4;
Number OPTIONS_TOP_Y:       0.55;
Number OPTIONS_ROW_SPACING: 0.15;
Number OPTIONS_COL_SPACING: 1.20;
Number OptionX(Number i): (i % OPTIONS_COLS - (OPTIONS_COLS - 1) / 2) * OPTIONS_COL_SPACING;
Number OptionY(Number i): OPTIONS_TOP_Y - Floor(i / OPTIONS_COLS) * OPTIONS_ROW_SPACING;

playervar Boolean optionsMenuOpen;
playervar Number hoveredOption;     // option index (row * OPTIONS_COLS + col)
playervar Number[] optionsMenuTexts;

rule: "options menu"
Event.OngoingPlayer
if (timelineOpen)
if (trackMenuCreated)
{
    optionsMenuTexts = [];

    CreateInWorldText(
        VisibleTo:      local.optionsMenuOpen ? local : null,
        Header:         "Options",
        Position:       RenderPosOf(0, OPTIONS_TOP_Y + 0.15),
        Scale:          2,
        TextColor:      Color.White,
        Reevaluation:   InworldTextRev.VisibleToAndPosition,
        Clipping:       Clipping.DoNotClip,
        Spectators:     Spectators.VisibleNever);
    optionsMenuTexts = optionsMenuTexts + LastTextID();

    for (Number i = 0; i < OPTIONS_COLS * OPTIONS_ROWS; i++)
    {
        if (!timelineOpen)
            break;

        // todo: replace placeholders
        CreateInWorldText(
            VisibleTo:      local.optionsMenuOpen ? local : null,
            Header:         <"Option <0>", Once(i) + 1>,
            Position:       RenderPosOf(OptionX(Once(i)), OptionY(Once(i))),
            Scale:          1.5,
            TextColor:      local.hoveredOption == Once(i) ? BluePulse() : Color.White,
            Reevaluation:   InworldTextRev.VisibleToPositionStringAndColor,
            Clipping:       Clipping.DoNotClip,
            Spectators:     Spectators.VisibleNever);
        optionsMenuTexts = optionsMenuTexts + LastTextID();
        MinWait();
    }

    WaitUntil(!timelineOpen, 99999);

    for (Number i = 0; i < optionsMenuTexts.Length; i++)
        DestroyInWorldText(optionsMenuTexts[i]);

    optionsMenuTexts = [];
}

////////////////////
//
// drag handling
//
////////////////////

rule: "drag"
Event.OngoingPlayer
if (IsPrimaryHeld())
if (dragTarget != Drag.None)
{
    Number snapFrame = -1;
    for (Number i = 0; i < flags.Length; i++)
    {
        if (Abs(FrameToTrackX(flags[i], player) - CursorX(player)) < SNAP_DIST)
        {
            snapFrame = flags[i];
            break;
        }
    }

    switch (dragTarget)
    {
        case Drag.Seeker:
            if (snapFrame != -1)
                currFrame = Clamp(snapFrame, trimStart, trimEnd);
            else
                currFrame = Clamp(TrackXToFrame(CursorX(player), player), trimStart, trimEnd);

            break;

        case Drag.LHandle:
            if (snapFrame != -1 && snapFrame <= trimEnd)
                trimStart = snapFrame;
            else
                trimStart = Clamp(TrackXToFrame(CursorX(player), player), 0, trimEnd);

            if (currFrame < trimStart)
            {
                StopAll();
                currFrame = trimStart;
            }

            break;

        case Drag.RHandle:
            if (snapFrame != -1 && snapFrame >= trimStart)
                trimEnd = snapFrame;
            else
                trimEnd = Clamp(TrackXToFrame(CursorX(player), player), trimStart, timelineFrames);

            if (currFrame > trimEnd)
            {
                StopAll();
                currFrame = trimEnd;
            }

            break;
    }

    MinWait();
    LoopIfConditionIsTrue();
}

rule: "grab lhandle"
Event.OngoingPlayer
if (timelineOpen)
if (!recording)
if (timelineFrames > 0)
if (IsPrimaryHeld())
if (IsInRange(CursorX(player), TrimStartX(player) - HANDLE_HALF_W, TrimStartX(player) + HANDLE_HALF_W)
    && (TrimEndX(player) - TrimStartX(player)) > HANDLE_MIN_GAP) // prevent grabbing left handle if right handle is overlapping
if (IsInRange(CursorY(player), HANDLE_Y_MIN, HANDLE_Y_MAX))
if (!IsDragging(player))
{
    dragTarget = Drag.LHandle;

    WaitUntil(!IsPrimaryHeld() || !timelineOpen, 99999);

    dragTarget = Drag.None;
}

rule: "grab rhandle"
Event.OngoingPlayer
if (timelineOpen)
if (!recording)
if (timelineFrames > 0)
if (IsPrimaryHeld())
if (IsInRange(CursorX(player), TrimEndX(player) - HANDLE_HALF_W, TrimEndX(player) + HANDLE_HALF_W)
    || (TrimEndX(player) - TrimStartX(player)) < HANDLE_MIN_GAP) // grab right handle if its overlapping the left handle
if (IsInRange(CursorY(player), HANDLE_Y_MIN, HANDLE_Y_MAX))
if (!IsDragging(player))
{
    dragTarget = Drag.RHandle;

    WaitUntil(!IsPrimaryHeld() || !timelineOpen, 99999);

    dragTarget = Drag.None;
}

rule: "grab seeker"
Event.OngoingPlayer
if (timelineOpen)
if (!recording)
if (timelineFrames > 0)
if (IsPrimaryHeld())
if (Abs(CursorX(player)) < TRACK_HALF)
if (IsInRange(CursorY(player), SEEKER_Y_MIN, SEEKER_Y_MAX))
if (!IsDragging(player))
{
    dragTarget = Drag.Seeker;

    if (playbackActive)
        StopAll();

    WaitUntil(!IsPrimaryHeld() || !timelineOpen, 99999);

    dragTarget = Drag.None;
}

////////////////////
//
// keybinds
//
////////////////////

rule: "open menu toggle"
Event.OngoingPlayer
if (IsInteractHeld())
{
    WaitIfTrue(0.2);
    hoveredCtrl = Ctrl.Invalid;

    timelineOpen = !timelineOpen;
    if (timelineOpen)
    {
        facing = Facing();
        facingX = HorizontalAngleFromDirection(facing);
        facingY = VerticalAngleFromDirection(facing);
        SetAimSpeed(player, 10);
        SetMoveSpeed(player, 0);
        SetStatus(player, null, Status.Stunned, 0.01); // small stun to force player to stop holding abilities
        DisallowAllButtons();
    }
    else
    {
        trackMenuOpen = false;
        optionsMenuOpen = false;
        SetAimSpeed(player, 100);
        SetMoveSpeed(player, 100);
        AllowAllButtons();
    }
}

rule: "tl control keybinds"
Event.OngoingPlayer
if (timelineOpen)
if (!animating)
if (!IsDragging(player))
if (IsPrimaryHeld() || IsJumpHeld() || IsUltimateHeld() || IsAbility2Held())
{
    // Left Click
    if (IsPrimaryHeld() && hoveredCtrl != Ctrl.Invalid)
    {
        WaitUntil(!IsPrimaryHeld() || !timelineOpen, 99999);
        async! ActivateCtrl(hoveredCtrl);
    }
    else if (IsPrimaryHeld() && hoveredTrack != -1)
    {
        WaitUntil(!IsPrimaryHeld() || !timelineOpen, 99999);
        async! SelectTrack(hoveredTrack);
    }

    // keybinds
    else if (IsJumpHeld())
    {
        // Space while recording
        if (recording)
        {
            async! ActivateCtrl(Ctrl.Record);
        }
        // Space
        else if (!playbackActive)
        {
            async! ActivateCtrl(Ctrl.Play);
        }
        else
        {
            // Ctrl + Space
            if (IsCrouchHeld())
            {
                async! ActivateCtrl(Ctrl.Stop);
                Abort();
            }
            else
            {
                async! ActivateCtrl(Ctrl.Pause);
            }
        }
    }
    else if (IsUltimateHeld())
    {
        // Shift + Q
        if (IsAbility1Held())
        {
            async! ActivateCtrl(Ctrl.Rewind);
            Abort();
        }

        // loop prev frame while Q held
        while (IsUltimateHeld())
        {
            async! ActivateCtrl(Ctrl.PrevFrame);
            WaitIfTrue(0.125);
        }
    }
    else if (IsAbility2Held())
    {
        // Shift + E
        if (IsAbility1Held())
        {
            async! ActivateCtrl(Ctrl.Forward);
            Abort();
        }

        // loop next frame while E held
        while (IsAbility2Held())
        {
            async! ActivateCtrl(Ctrl.NextFrame);
            WaitIfTrue(0.125);
        }
    }
}

Number SCRUB_SECONDS: 1;
Number SCRUB_FRAMES:  Near(SCRUB_SECONDS / delta);
rule: "scrub keybind"
Event.OngoingPlayer
if (timelineOpen)
if (!recording)
if (!IsDragging(player))
if (!IsAbility1Held())
if (Abs(ThrottleX()) > 0.5)
{
    currFrame = Clamp(currFrame + (ThrottleX() > 0 ? -SCRUB_FRAMES : SCRUB_FRAMES), trimStart, trimEnd);

    WaitIfTrue(0.125);
    LoopIfConditionIsTrue();
}

playervar Number recordBindCount;
playervar Number lastRecordPress;
rule: "recording r x5 keybind"
Event.OngoingPlayer
if (IsReloadHeld())
{
    // 5x R to toggle recording
    if (Time() - lastRecordPress > 0.5)
        recordBindCount = 0;

    recordBindCount++;
    lastRecordPress = Time();

    if (recordBindCount >= 5)
    {
        recordBindCount = 0;
        async! ToggleRecording();
    }
}

rule: "flag jump keybind"
Event.OngoingPlayer
if (timelineOpen)
if (!animating)
if (!recording)
if (!IsDragging(player))
if (IsAbility1Held())
if (Abs(ThrottleX()) > 0.5)
{
    Number[] targets = ThrottleX() < 0
        ? SortedArray(flags.Filter(f => f > currFrame && f <= trimEnd), Curr())    // right ascending
        : SortedArray(flags.Filter(f => f < currFrame && f >= trimStart), -Curr()); // left descending

    if (playbackActive)
        StopAll();

    if (targets.Length > 0)
        currFrame = targets.First;
    else
        currFrame = ThrottleX() > 0 ? trimStart : trimEnd;

    WaitUntil(Abs(ThrottleX()) < 0.5 || !IsAbility1Held(), 99999);
}
