import "../main.del";

playervar Boolean recordArmed;

playervar Sample[] recChunk;    // chunk being recorded, moved into a take slot when full or when recording stops
playervar Sample[] recMid;      // moved into recChunk when full
playervar Sample[] recBuf;      // newest samples, moved into recMid when full
playervar Number recTime!;
playervar Number recOthers!;    // frames in the other tracks while recording, for MAX_TOTAL_SAMPLES
playervar Number recTrimEnd!;   // trim end a retake keeps, 0 when none

// recChunk into the next take slot, the slots go into storage when all are used
void SlotRecChunk() playervar "rec - slot chunk"
{
    if (recSlotsUsed == REC_SLOTS)
        FlushRecSlots();

    switch (recSlotsUsed)
    {
        case 0:  recSlot0 = recChunk;  break;
        case 1:  recSlot1 = recChunk;  break;
        case 2:  recSlot2 = recChunk;  break;
        case 3:  recSlot3 = recChunk;  break;
        case 4:  recSlot4 = recChunk;  break;
        case 5:  recSlot5 = recChunk;  break;
        case 6:  recSlot6 = recChunk;  break;
        case 7:  recSlot7 = recChunk;  break;
        case 8:  recSlot8 = recChunk;  break;
        case 9:  recSlot9 = recChunk;  break;
        case 10: recSlot10 = recChunk; break;
        case 11: recSlot11 = recChunk; break;
        case 12: recSlot12 = recChunk; break;
        case 13: recSlot13 = recChunk; break;
        case 14: recSlot14 = recChunk; break;
        case 15: recSlot15 = recChunk; break;
        case 16: recSlot16 = recChunk; break;
        case 17: recSlot17 = recChunk; break;
        case 18: recSlot18 = recChunk; break;
        default: recSlot19 = recChunk; break;
    }
    
    recSlotsUsed++;
    recChunk = [];
}

// the used take slots onto the end of recSlotTrack's storage in one append
// the slots and the copy are emptied after left full they're stored data on top of the tracks that the limits dont count (stored data makes the load spikes)
void FlushRecSlots() playervar "rec - flush slots"
{
    if (recSlotsUsed == 0 && recSlotKeep == 0)
        return;

    recTake = [recSlot0, recSlot1, recSlot2, recSlot3, recSlot4,
               recSlot5, recSlot6, recSlot7, recSlot8, recSlot9,
               recSlot10, recSlot11, recSlot12, recSlot13, recSlot14,
               recSlot15, recSlot16, recSlot17, recSlot18, recSlot19].Slice(0, recSlotsUsed);

    // a retake's first flush also cuts the old take after the chunks it keeps
    if (recSlotKeep > 0)
    {
        CutAppendTrackStage(recSlotTrack);
        recSlotKeep = 0;
    }
    else
        AppendTrackStage(recSlotTrack);

    recTake = [];
    recSlot0 = [];  recSlot1 = [];  recSlot2 = [];  recSlot3 = [];  recSlot4 = [];
    recSlot5 = [];  recSlot6 = [];  recSlot7 = [];  recSlot8 = [];  recSlot9 = [];
    recSlot10 = []; recSlot11 = []; recSlot12 = []; recSlot13 = []; recSlot14 = [];
    recSlot15 = []; recSlot16 = []; recSlot17 = []; recSlot18 = []; recSlot19 = [];
    recSlotsUsed = 0;
}

// a new sample in recBuf up the levels. the sample count is a multiple of BUFFER_SIZE, recMid is full every MID_SIZE samples, a chunk every CHUNK_SIZE
void RecLevelsUp() playervar "rec - level up"
{
    if (recBuf.Length == BUFFER_SIZE)
    {
        recMid += recBuf;
        recBuf = [];
        
        if (recMid.Length == MID_SIZE)
        {
            recChunk += recMid;
            recMid = [];
            
            if (recChunk.Length == CHUNK_SIZE)
                SlotRecChunk();
        }
    }
}

// the partial levels too, then the take goes into the track's storage
void RecLevelsFlush() playervar "rec - level flush"
{
    recMid += recBuf;
    recBuf = [];
    recChunk += recMid;
    recMid = [];
    
    if (recChunk.Length > 0)
        SlotRecChunk();

    FlushRecSlots();
}

// a retake keeps the track's first keep chunks, the rest stays stored until FlushRecSlots cuts it
void BeginTake(Number t!, Number keep! = 0) playervar "rec - begin take"
{
    if (keep == 0)
        ClearTrack(t);

    recSlotKeep = keep;
    recChunk = [];
    recMid = [];
    recBuf = [];
    recSlotsUsed = 0;
    recSlotTrack = t;
}

// a retake keeps the first kept samples of track t. whole chunks stay in storage, the rest of the next chunk goes back into the levels
void BeginPunch(Number t!, Number kept!) playervar "rec - begin punch"
{
    // the chunk the take starts in, read before BeginTake clears a track that keeps no whole chunk. into botChunkA, the
    // countdown ended FirstPerson so the human's "bot playback" isn't using it
    tickI = Floor(kept / CHUNK_SIZE);
    ReadChunkToA(t);
    BeginTake(t, tickI);

    // the old take stays stored until the first flush, on top of the slots this take fills until then. cut now if that could pass the budget
    if (recOthers + trackFrames[t] + (REC_SLOTS + 1) * CHUNK_SIZE > MAX_TOTAL_SAMPLES)
        FlushRecSlots();

    Number mids! = Floor(kept % CHUNK_SIZE / MID_SIZE) * MID_SIZE;

    // less than a mid goes through recBuf, so no level fills up here
    recChunk = botChunkA.Slice(0, mids);
    for (Number s! = mids; s < kept % CHUNK_SIZE; s++)
    {
        recBuf += botChunkA[s];
        RecLevelsUp();
    }
    botChunkA = [];
    botWinC = -2; // no window loaded
}

rule: "instant respawn"
Event.OngoingPlayer
if (!IsDummyBot())
if (IsDead())
if (!recording || OptOn(Opt.InstantRespawn))
if (botOwner != player) // "bot playback" respawns the human playing FirstPerson
{
    Vector pos! = PosOf();
    Vector facing! = Facing();
    Respawn();
    ApplyMovementState();
    TeleportFacing(NearestWalkablePos(pos), facing);
}

// rule: "unkillable outside recording"
