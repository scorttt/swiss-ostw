Number RecHealth(): Min(opts[Opt.RecHealthValue], MaxHealth());

playervar Number recHealthMax!;
rule: "recording health follows hero"
Event.OngoingPlayer
if (!IsDummyBot())
if (IsAlive())
if (MaxHealth() > 0)
if (MaxHealth() != recHealthMax)
{
    MinWait();
    if (MaxHealth() > 0)
    {
        if (opts[Opt.RecHealthValue] == recHealthMax || opts[Opt.RecHealthValue] > MaxHealth())
            opts[Opt.RecHealthValue] = MaxHealth();

        recHealthMax = MaxHealth();
    }
    LoopIfConditionIsTrue();
}

rule: "recording health no damage"
Event.OngoingPlayer
if (!IsDummyBot())
if (!recording)
if (OptOn(Opt.RecHealth))
{
    SetDamageHealingReceived(0);
    WaitUntil(recording || !OptOn(Opt.RecHealth), 99999);
    SetDamageHealingReceived(100);
}

rule: "recording set health"
Event.OngoingPlayer
if (!IsDummyBot())
if (!recording)
if (!firstPerson)
if (OptOn(Opt.RecHealth))
if (IsAlive())
if (Health() != RecHealth())
{
    SetPlayerHealth(player, RecHealth());
}

Number REC_COUNTDOWN: 3;
playervar Number recCount!; // seconds left of the countdown, shown in the time elapsed text. 0 while not counting
playervar Boolean preRolling!;
Number PUNCH_POS_RADIUS: 0.50;
Number PUNCH_AIM_DIST:   10;
Number PUNCH_AIM_SIZE:   0.05; // sphere radius per meter

Number WHOLE_TAKE: -1; // punchFrame of a whole take, a retake's is the frame it starts at
playervar Number punchFrame!;
playervar Vector punchPos!;
playervar Vector punchDir!;
playervar Vector punchAim!;
playervar Number punchAimR!;
playervar Number punchHealth!;
playervar Boolean punchAir!; // the recording is in the air at that frame, the player is held at that spot until the recording actually starts, then let go at the recorded velocity
playervar Vector punchVel!;
playervar Boolean punchLocked!;
playervar Boolean canRetake!;

Number TakeStart(Player p = player): p.punchFrame == WHOLE_TAKE ? p.recStart : p.punchFrame;
Boolean RecordRetakes(Player p = player): p.canRetake && (!p.recordArmed || p.punchFrame != WHOLE_TAKE);
Boolean RetakeHeroMatches(): HeroOf() == trackHero[focusedTrack];
Boolean PunchInPlace(): DistanceBetween(Vector(PosOf().X, 0, PosOf().Z), Vector(punchPos.X, 0, punchPos.Z)) <= PUNCH_POS_RADIUS;
Boolean PunchAimed():   DistanceBetween(EyePos() + Facing() * DistanceBetween(EyePos(), punchAim), punchAim) <= punchAimR;
Boolean PunchLinedUp(): PunchInPlace() && PunchAimed();

rule: "record countdown"
Event.OngoingPlayer
if (recordArmed)
if (!timelineOpen)
{
    // a retake WAS armed, so focus, playhead, or trim could have changed
    if (punchFrame != WHOLE_TAKE)
    {
        // from the track's start (or with no track) nothing would be kept, so it's a whole take
        if (!HasRecording() || currFrame <= recStart)
            punchFrame = WHOLE_TAKE;
        // a whole take would replace the track the retake was meant to keep
        else if (!RetakeHeroMatches() || recStart + recFrames <= trimStart)
        {
            recordArmed = false;
            SmallMessage(player, RetakeHeroMatches()
                ? <"Track <0> ends before the trim start, move it or replace the whole track", focusedTrack + 1>
                : <"Track <0> needs <1>, change hero or replace the whole track", focusedTrack + 1, trackHero[focusedTrack]>);
            return;
        }
    }

    // take replaces the focused track, only other tracks count toward MAX_TOTAL_SAMPLES
    recOthers = 0;
    
    for (Number t! = 0; t < MAX_TRACKS; t++)
    {
        if (t != focusedTrack)
            recOthers += trackFrames[t];
    }
    
    if (recOthers >= MAX_TOTAL_SAMPLES)
    {
        recordArmed = false;
        SmallMessage(player, "Recording limit reached! 10 minute budget for all tracks, delete a track first");
        return;
    }

    StopAll();
    orbiting = false;

    if (firstPerson)
    {
        FirstPersonRelease();
        WaitUntil(!firstPersonReturn, 1);
    }

    DestroyTrackBot(focusedTrack);

    Number from! = currFrame;
    Number target! = OptOn(Opt.RecFromTrimStart) ? trimStart : currFrame; // take start
    Boolean guides! = punchFrame != WHOLE_TAKE;
    Any posRing!;
    Any posSphere!;
    Any aimSphere!;
    Number hint!;

    if (guides)
    {
        // a retake starts at the playhead within the track
        target = Min(currFrame, recStart + recFrames - 1);
        punchFrame = target;
        Number s! = target - recStart;
        ReadTrackSample(focusedTrack, s);
        punchPos = readPos;
        punchDir = LookDir(readLook);
        punchHealth = readLook.Z;
        punchAir = !HasBit(readCtrl.Y, Bit.Ground);
        TeleportFacing(punchPos, punchDir);

        // hold the player in air
        if (punchAir)
        {
            ReadTrackSample(focusedTrack, Min(s + 1, recFrames - 1));
            punchVel = (readPos - punchPos) / delta;
            StartForcingPlayerPosition(player, punchPos, false); // for some reason this makes the player's aim feel floaty - dont care!
        }

        // the sphere sits along the recorded aim from the player's eye height at the spot, backed off the first surface until it just touches it
        Vector eye! = punchPos + EyePos() - PosOf();
        Vector aimEnd! = eye + punchDir * PUNCH_AIM_DIST;
        Number headOn! = Max(Abs(Dot(punchDir, RayNormal(eye, aimEnd, null))), 0.25); // 1 when nothing's hit, the normal then points back along the ray
        Number dist! = DistanceBetween(eye, RayHit(eye, aimEnd, null)) * headOn / (headOn + PUNCH_AIM_SIZE);
        punchAim = eye + punchDir * dist;
        punchAimR = dist * PUNCH_AIM_SIZE;

        CreateEffect(player, Effect.Ring, PunchInPlace() ? Color.Green : Color.White, punchPos, PUNCH_POS_RADIUS, EffectRev.VisibleToPositionRadiusAndColor);
        posRing = LastCreatedEntity();
        CreateEffect(player, Effect.Sphere, PunchInPlace() ? Color.Green : Color.White, punchPos, PUNCH_POS_RADIUS / 4, EffectRev.VisibleToPositionRadiusAndColor);
        posSphere = LastCreatedEntity();
        CreateEffect(player, Effect.Sphere, PunchAimed() ? Color.Green : Color.White, punchAim, punchAimR, EffectRev.VisibleToPositionRadiusAndColor);
        aimSphere = LastCreatedEntity();
        CreateHudText(
            VisibleTo:      player,
            Text:           punchAir ? " \n\n\nAim at the sphere to start the retake countdown" : " \n\n\nStay in the ring while aiming at the sphere to start the retake countdown",
            Location:       Location.Top,
            SortOrder:      1,
            TextColor:      Color.White,
            Reevaluation:   HudTextRev.VisibleTo,
            Spectators:     Spectators.VisibleNever);
        hint = LastTextID();
    }
    // retakes start from the same spot, before the countdown so it's spent there. reads the old samples, take clears them
    else if (OptOn(Opt.TeleportOnRecord) && HasRecording())
    {
        ReadTrackSample(focusedTrack, 0);
        TeleportFacing(readPos, LookDir(readLook));
    }
    currFrame = target; // the other bots show the frame the take starts at

    // retake countdown only while lined up, and cancels if the player looks away. move speed is 0 while lined up, so keys can be held before recording actually starts
    Number end! = -1; // countdown end. -1 while not counting
    while (recordArmed && !timelineOpen && (end == -1 || Time() < end))
    {
        tickJ = !guides || PunchLinedUp();
        if (tickJ && end == -1)
        {
            end = Time() + REC_COUNTDOWN;
            // only with a whole countdown of timeline before the take, a take near the start gets a plain countdown
            preRolling = OptOn(Opt.PreRoll) && OptOn(Opt.PlayWhileRecording) && target >= REC_COUNTDOWN / delta;
            punchLocked = guides;
            ApplyMovementState();
        }
        else if (!tickJ && end != -1)
        {
            end = -1;
            recCount = 0;
            preRolling = false;
            punchLocked = false;
            ApplyMovementState();
            currFrame = target;
            SmallMessage(player, "Countdown stopped, line up again");
        }

        if (end != -1)
        {
            tickI = Ceil(end - Time());
            if (tickI != recCount)
                recCount = tickI;
            // reaches the take's start as the countdown ends
            if (preRolling)
                currFrame = target - Near((end - Time()) / delta);
        }
        MinWait();
    }
    if (guides)
    {
        DestroyEffect(posRing);
        DestroyEffect(posSphere);
        DestroyEffect(aimSphere);
        DestroyHudText(hint);

        if (punchAir)
        {
            StopForcingPlayerPosition();

            if (recordArmed && !timelineOpen)
                MinWait();
        }
    }
    recCount = 0;
    preRolling = false;
    punchLocked = false; // applied by StartRecording or below

    // still armed with the timeline closed, so the countdown ran out
    if (recordArmed && !timelineOpen)
    {
        // lined up within the ring and sphere, so correct whatever error is there. a player that's held in the air is let go at the forward differenced velocity
        if (guides && punchAir)
        {
            SetFacing(player, punchDir, Relative.ToWorld);
            ApplyImpulse(player, punchVel, Mag(punchVel), Relative.ToWorld, ContraryMotion.Cancel);
        }
        else if (guides)
            TeleportFacing(punchPos, punchDir);

        currFrame = target;
        StartRecording();
    }
    else
    {
        ApplyMovementState();
        currFrame = from;
        SpawnIdleTrackBot(focusedTrack);
    }
}

void StartRecording() playervar "rec - start recording"
{
    recordArmed = false;

    if (OptOn(Opt.Noclip) && OptOn(Opt.NoclipAutoOff))
        opts[Opt.Noclip] = false;

    ApplyMovementState();

    trackHero[focusedTrack] = HeroOf();

    if (punchFrame == WHOLE_TAKE)
    {
        ResetHeroConsumables();
        flags = [];
        recStart = currFrame;
        recTrimEnd = HasRecording() && trimEnd < timelineFrames && trimEnd > recStart ? trimEnd : 0;
        BeginTake(focusedTrack);
        recFrames = 0;
    }
    else
    {
        flags = flags.Filter(f => f < currFrame);
        recTrimEnd = trimEnd < timelineFrames && trimEnd > recStart ? trimEnd : 0;
        recFrames = currFrame - recStart;
        BeginPunch(focusedTrack, recFrames);
    }
    trackStart[focusedTrack] = recStart;
    trackFrames[focusedTrack] = recFrames;
    recLimit = Min(MAX_TRACK_SAMPLES, MAX_TOTAL_SAMPLES - recOthers);

    if (OptOn(Opt.StopAtTrimEnd) && trimEnd > currFrame)
        recLimit = Min(recLimit, trimEnd - recStart);

    UpdateTimelineFrames();

    // a retake continues the recorded health
    if (punchFrame != WHOLE_TAKE && punchHealth > 0)
        SetPlayerHealth(player, punchHealth);
    else if (OptOn(Opt.RecHealth))
        SetPlayerHealth(player, RecHealth());

    recTime = Time() - recFrames * delta; // the frame count comes from the time, a retake starts with the kept frames
    recording = true;
}

void StopRecording() playervar "rec - stop recording"
{
    recording = false;
    currFrame = TakeStart();
    punchFrame = WHOLE_TAKE;
    trackLabelsFresh = false;
    RecLevelsFlush();

    if (HasRecording())
        async! FinishTake(focusedTrack);

    SmallMessage(player, <"Track <0> saved: <1> long with <2> frames", focusedTrack + 1, FormattedFrameToSec(recFrames), recFrames>);
}

void FinishTake(Number t!) playervar "rec - finish take"
{
    MinWait();

    // here and not in Stop Recording, the growth in "recording" runs after that on a limit stop
    if (recTrimEnd > 0)
        trimEnd = Min(recTrimEnd, timelineFrames);

    if (trackHidden[t])
        SmallMessage(player, <"Track <0> is hidden, unhide it to see its playback", t + 1>);

    if (OptOn(Opt.NextTrackAfterRec) && focusedTrack == t)
    {
        Number[] empty! = SortedArray(TRACK_IDS.Filter(u => u != t && trackFrames[u] == 0), (Curr() - t + MAX_TRACKS) % MAX_TRACKS);
        if (empty.Length > 0)
        {
            SelectTrack(empty.First);
            SmallMessage(player, <"Track <0> selected", empty.First + 1>);
        }
            
    }

    WaitUntil(ServerLoad() < 200, 3);
    SpawnIdleTrackBot(t); // could be deleted or played firstPerson meanwhile
}

rule: "recording"
Event.OngoingPlayer
if (recording)
{
    // frames come from Time(), just so it wont drop a sample if theres a skipped server tick for whatever reason
    while (recording && recFrames < Near((Time() - recTime) / delta) + 1)
    {
        recBuf += {
            Pos:  PosOf(),
            Look: Vector(HorizontalAngleFromDirection(Facing()), VerticalAngleFromDirection(Facing()), Health()),
            Ctrl: Vector(ThrottleX(),
                    (IsPrimaryHeld() ? Bit.Primary : 0) + (IsSecondaryHeld() ? Bit.Secondary : 0) + (IsAbility1Held() ? Bit.Ability1 : 0)
                    + (IsAbility2Held() ? Bit.Ability2 : 0) + (IsUltimateHeld() ? Bit.Ultimate : 0) + (IsInteractHeld() ? Bit.Interact : 0)
                    + (IsJumpHeld() ? Bit.Jump : 0) + (IsCrouchHeld() ? Bit.Crouch : 0) + (IsMeleeHeld() ? Bit.Melee : 0) + (IsReloadHeld() ? Bit.Reload : 0)
                    + (IsUsingAbility1() ? Bit.UsingAb1 : 0) + (IsUsingAbility2() ? Bit.UsingAb2 : 0) + (IsUsingUltimate() ? Bit.UsingUlt : 0)
                    + (IsOnGround() ? Bit.Ground : 0) + (IsDead() ? Bit.Dead : 0),
                    ThrottleOf().Z)};

        recFrames++;
        trackFrames[focusedTrack] = recFrames;
        RecLevelsUp();

        if (recFrames >= recLimit)
        {
            StopRecording();
            
            if (recFrames >= MAX_TRACK_SAMPLES)
                SmallMessage(player, "Track full, recording stopped");
            else if (recOthers + recFrames >= MAX_TOTAL_SAMPLES)
                SmallMessage(player, "Recording limit reached: 10 minutes across all tracks, recording stopped");

        }
    }

    // grow the timeline and playback range to fit the recording, a stop needs it too
    // tickK is the recording's end, a plain variable since this runs every tick
    tickK = recStart + recFrames;
    if (tickK > timelineFrames)
        timelineFrames = tickK;
    if (tickK > trimEnd)
        trimEnd = tickK;

    if (!recording)
        return;

    if (OptOn(Opt.StopOnDeath) && IsDead())
    {
        StopRecording();
        return;
    }

    currFrame = tickK;

    MinWait();
    LoopIfConditionIsTrue();
}

Number REC_CONFIRM_TIME: 3;
playervar Number recBindTime!;
void ToggleRecording() playervar "rec - toggle recording"
{
    if (recording)
        StopRecording();

    else if (!recordArmed && HasRecording() && Time() - recBindTime > REC_CONFIRM_TIME)
    {
        recBindTime = Time();
        SmallMessage(player, <"Replaces track <0>, press again to confirm", focusedTrack + 1>);
    }
    else
    {
        recordArmed = !recordArmed;
        punchFrame = WHOLE_TAKE; // the keybind always records the whole track
        recBindTime = -REC_CONFIRM_TIME;
    }
}
