import "state.del";

playervar Boolean recordArmed;

void StartRecording() playervar "Rec Sub : Start Recording"
{
    // focused track restarts at trimStart, other tracks are untouched
    recordArmed = false;
    StopAll();
    trackMenuOpen = false;
    optionsMenuOpen = false;
    trackHero[focusedTrack] = HeroOf(player);
    flags = [];
    recStart = trimStart;
    recFrames = 0;
    currFrame = trimStart;
    UpdateTimelineFrames();
    ClampToTimeline();
    recording = true;
}

void StopRecording() playervar "Rec Sub : Stop Recording"
{
    recording = false;
    currFrame = recStart;

    SmallMessage(player, <"Track <0> saved: <1> long with <2> frames", focusedTrack + 1, FormattedFrameToSec(recFrames), recFrames>);
}

// record countdown
rule: "record countdown"
Event.OngoingPlayer
if (recordArmed)
if (!timelineOpen)
{
    for (Number i! = 3; i > 0; i--)
    {
        SmallMessage(player, i);
        WaitIfTrue(1);
    }

    StartRecording();
}

rule: "recording"
Event.OngoingPlayer
if (recording)
{
    recFrames++;
    currFrame = recStart + recFrames;

    // grow the timeline and playback range to fit the recording
    if (currFrame > timelineFrames)
        timelineFrames = currFrame;
    if (currFrame > trimEnd)
        trimEnd = currFrame;

    MinWait();
    LoopIfConditionIsTrue();
}

void ToggleRecording() playervar "Rec Sub : Toggle Recording"
{
    if (recording)
        StopRecording();
    else
        recordArmed = !recordArmed;
}
