rule: "Initial Global"
{
    PauseMatchTime();
}

rule: "give ult"
Event.OngoingPlayer
if (IsAlive())
if (UltimateChargePercent() != 100)
{
    SetUltimateCharge(player, 100);
    MinWait();
    LoopIfConditionIsTrue();
}